        "metrics": {
          "Consolidated EBITDA": 120000000
        }
      }
    ],
    "cases": [
      {
        "id": "F-R1",
        "rule": "7.01(b)",
        "inputs": "ledger only",
        "expected": {
          "status": "AVAILABLE",
          "capacity": 50000000,
          "used": 18000000,
          "remaining": 32000000
        },
        "invariant": "remaining = cap − sum(unsuperseded usage); never ignore ledger usage."
      },
      {
        "id": "F-R2",
        "rule": "7.01(c)",
        "inputs": "approved snapshot as of 2026-06-30 (EBITDA 80,000,000), evaluated as of 2026-06-30",
        "expected": {
          "status": "AVAILABLE",
          "capacity": 16000000,
          "used": 0,
          "remaining": 16000000
        },
        "invariant": "20% × approved EBITDA; the DRAFT snapshot's 120,000,000 must not be used under the default policy."
      },
      {
        "id": "F-R2c",
        "rule": "7.01(c)",
        "inputs": "approved snapshot as of 2026-06-30 only, evaluated as of 2026-09-30",
        "expected": {
          "status": "NEEDS_INPUT"
        },
        "invariant": "An approved pack dated before the evaluation date is not used silently."
      },
      {
        "id": "F-R3",
        "rule": "7.01(c)",
        "inputs": "no snapshot",
        "expected": {
          "status": "NEEDS_INPUT"
        },
        "invariant": "No metric → no number."
      },
      {
        "id": "F-R4",
        "rule": "7.01(c)",
        "inputs": "DRAFT snapshot as of 2026-09-30 only, evaluated as of 2026-09-30",
        "expected": {
          "status": "NEEDS_INPUT"
        },
        "invariant": "An unapproved snapshot must not silently supply the metric under the default resolution policy."
      },
      {
        "id": "F-R5",
        "rule": "7.06(b)",
        "inputs": "ledger (4,000,000 on 7.06(b) + 9,000,000 on 7.08(c))",
        "expected": {
          "status": "AVAILABLE",
          "capacity": 20000000,
          "used": 13000000,
          "remaining": 7000000
        },
        "invariant": "Shared-cap usage from the sibling clause must count."
      },
      {
        "id": "F-R6",
        "rule": "7.08(c)",
        "inputs": "same ledger",
        "expected": {
          "status": "AVAILABLE",
          "capacity": 20000000,
          "used": 13000000,
          "remaining": 7000000
        },
        "invariant": "Same remaining as F-R5 — one pool, two doors."
      },
      {
        "id": "F-R7",
        "rule": "7.01(f)",
        "inputs": "no FX",
        "expected": {
          "status": "NEEDS_INPUT|UNSUPPORTED"
        },
        "invariant": "No USD figure may be emitted for a EUR basket without an FX input."
      },
      {
        "id": "F-R8",
        "rule": "7.01(b) after proposing 35,000,000 new usage",
        "inputs": "ledger",
        "expected": {
          "status": "EXCEEDS|NOT_AVAILABLE",
          "remainingAfter": -3000000
        },
        "invariant": "32,000,000 remaining < 35,000,000 proposed → the simulation must not report headroom."
      },
      {
        "id": "F-R9",
        "rule": "7.01(b) with usage-f-1 superseded by a 10,000,000 correction",
        "inputs": "ledger with explicit supersession",
        "expected": {
          "status": "AVAILABLE",
          "used": 16000000,
          "remaining": 34000000
        },
        "invariant": "Superseded usage must not double count; the correction replaces, not adds."
      }
    ]
