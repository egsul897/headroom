DATABASE_URL="postgresql://headroom:headroom@localhost:5432/headroom?schema=public"

# SaaS auth (NextAuth v4). REQUIRED in every deployed environment.
# NEXTAUTH_SECRET: long random value, e.g. `openssl rand -base64 32`.
# NEXTAUTH_URL: the deploy URL, e.g. https://headroom.example.com.
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Dev-only company chooser (founder/dev test companies). NEVER enable in
# production: HEADROOM_DEV_CHOOSER=1 only renders the old chooser when
# NODE_ENV !== "production". Unset (default) = SaaS root: signed-in users go
# straight to their own dashboard, unsigned visitors go to /login.
# HEADROOM_DEV_CHOOSER=

# Optional: Neon HTTPS transport for Cloud Agents that block TCP 5432.
# Unset keeps Prisma's default TCP engine. Values: https
# NEON_TRANSPORT=https

# Document onboarding pipeline (docs/document-onboarding-pipeline-foundation.md).
# Names only - no real values committed here.

# @vercel/blob's own standard read-write token. Unset -> lib/document-storage's
# getDocumentStorageProvider() falls back to LocalFilesystemStorageProvider
# (.local-blob-storage/, gitignored) for local dev and tests.
BLOB_READ_WRITE_TOKEN=

# @anthropic-ai/sdk's own standard API key env var, read by AnthropicExtractionProvider
# (lib/extraction/anthropic-provider.ts).
ANTHROPIC_API_KEY=

# Overrides the Claude model AnthropicExtractionProvider calls. Defaults to
# claude-opus-5 when unset - see lib/extraction/anthropic-provider.ts.
EXTRACTION_MODEL=

# SEC EDGAR fair-access identity for WS-EHB historical discovery (and peers).
# REQUIRED for live SEC requests. Must include a real authorized contact email.
# Do NOT use example.com / placeholder addresses — there is no invented default.
# SEC_EDGAR_USER_AGENT="HeadroomHistoricalBackfill/1.0 (contact: you@yourdomain; research; respectful fair-access)"
# Or split:
# SEC_EDGAR_CONTACT_EMAIL=
# SEC_EDGAR_USER_AGENT_NAME=HeadroomHistoricalBackfill/1.0
#
# Fleet-safe live fetch: only one designated owner may live-fetch across Cloud
# Agents unless a shared budget file is on a common volume.
# HEADROOM_SEC_FETCH_OWNER=WS-EHB
# HEADROOM_SEC_SHARED_BUDGET_PATH=
