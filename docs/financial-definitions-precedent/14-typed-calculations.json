    {
      "name": "Consolidated Senior Secured Leverage Ratio (CONMED)",
      "sourceDocIds": [
        "CONMED-2025-PLAIN",
        "CONMED-2025-ART7"
      ],
      "extractionEntryIds": [
        "CONMED-2025-CA::def::Consolidated_Senior_Secured_Leverage_Ratio",
        "CONMED-2025-CA::test::Financial_Covenants_7_1"
      ],
      "components": [
        {
          "kind": "RATIO_NUMERATOR",
          "label": "Consolidated Senior Secured Funded Debt + RTP attributed principal \u2212 cash netting",
          "inputs": [
            "consolidated_senior_secured_funded_debt",
            "rtp_attributed_principal",
            "unrestricted_cash_and_cash_equivalents"
          ]
        },
        {
          "kind": "CAP",
          "label": "cash netting cap",
          "expression": "min(100_000_000, unrestricted_cash_and_cash_equivalents)",
          "inputs": [
            "unrestricted_cash_and_cash_equivalents"
          ]
        },
        {
          "kind": "RATIO_DENOMINATOR",
          "label": "Consolidated EBITDA",
          "inputs": [
            "consolidated_ebitda_covenant_defined"
          ]
        },
        {
          "kind": "CONDITIONAL_TEST",
          "label": "maintenance max 3.75x with optional Material Acquisition step-up +0.50x",
          "inputs": [
            "material_acquisition_election_and_dates"
          ]
        },
        {
          "kind": "FINANCIAL_INPUT_REQUIREMENT",
          "label": "all numerator/denominator inputs must be attested",
          "onMissing": "MISSING_INPUT"
        }
      ],
      "arithmeticEvaluable": true,
      "legalCertified": false,
      "id": "TC-CONMED-SSLR-v1",
      "legalReviewState": "SEMANTIC_HYPOTHESIS"
    },
    {
      "name": "EBITDA with Combined Cap (DSGR Second A&R)",
      "sourceDocIds": [
        "DSGR-2025-AR2"
      ],
      "extractionEntryIds": [
        "DSGR-2025-AR2::def::EBITDA",
        "DSGR-2025-AR2::adj::Cost_Savings",
        "DSGR-2025-AR2::adj::Combined_Cap_20pct"
      ],
      "components": [
        {
          "kind": "BASE_METRIC",
          "label": "Net Income",
          "inputs": [
            "net_income"
          ]
        },
        {
          "kind": "ADDBACK",
          "label": "(a)(i) Interest Expense",
          "inputs": [
            "interest_expense"
          ]
        },
        {
          "kind": "ADDBACK",
          "label": "(a)(ii) income tax expense net of refunds",
          "inputs": [
            "income_tax_expense_net"
          ]
        },
        {
          "kind": "ADDBACK",
          "label": "(a)(iii) D&A",
          "inputs": [
            "depreciation_amortization"
          ]
        },
        {
          "kind": "ADDBACK",
          "label": "(a)(vii) non-recurring/unusual/restructuring etc.",
          "inputs": [
            "nonrecurring_unusual_expenses"
          ],
          "capRef": "COMBINED_CAP"
        },
        {
          "kind": "ADDBACK",
          "label": "(a)(viii) Cost Savings run-rate",
          "inputs": [
            "cost_savings_projected",
            "cost_savings_benefits_realized"
          ],
          "capRef": "COMBINED_CAP",
          "lookforward": "24 months from period end; actions taken prior to last day of period"
        },
        {
          "kind": "PRO_FORMA_ADJUSTMENT",
          "label": "Cost Savings as-if first day of period, net of benefits realized",
          "inputs": [
            "cost_savings_projected",
            "cost_savings_benefits_realized"
          ]
        },
        {
          "kind": "CAP",
          "label": "Combined Cap = 20% of EBITDA before capped add-backs",
          "expression": "0.20 * ebitda_before_capped_addbacks",
          "appliesTo": [
            "(a)(vii)",
            "(a)(viii)",
            "(a)(xviii)(b)"
          ]
        },
        {
          "kind": "LOOKBACK_OR_LOOKFORWARD",
          "label": "Cost Savings realization within 24 months",
          "inputs": [
            "cost_savings_action_dates"
          ]
        },
        {
          "kind": "DOUBLE_COUNTING_RESTRICTION",
          "label": "without duplication lead-in; Combined Cap shared across named clauses",
          "inputs": []
        },
        {
          "kind": "FINANCIAL_INPUT_REQUIREMENT",
          "label": "missing Net Income or capped add-back schedule \u2192 MISSING_INPUT",
          "onMissing": "MISSING_INPUT"
        }
      ],
      "arithmeticEvaluable": true,
      "legalCertified": false,
      "id": "TC-DSGR-EBITDA-v1",
      "legalReviewState": "SEMANTIC_HYPOTHESIS"
    },
