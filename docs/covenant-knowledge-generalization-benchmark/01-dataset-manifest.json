{
  "protocol": {
    "schemaVersion": "ckg-benchmark.v1",
    "title": "Headroom Covenant Knowledge Generalization Benchmark",
    "purpose": "Independent measurement of covenant-knowledge coverage and generalization on held-out public agreements. Not a certification gate. Not a Claude-owned acceptance suite.",
    "hardRules": [
      "Do not modify Claude-owned acceptance tests or their fixtures.",
      "Held-out documents in this dataset must not be used for prompt tuning or extraction-rule development.",
      "Never mark model-generated interpretations as verified ground truth.",
      "Labels must be SOURCE_VERIFIED (direct public-source adjudication) or REVIEWER_APPROVED (synthetic / prior independent GT). UNLABELED is a first-class outcome, distinct from FAILURE and SUCCESS.",
      "No paid model calls in the evaluation harness. Offline scoring only.",
      "No merges, certification status changes, or production extraction-rule changes as part of this benchmark."
    ],
    "labelAuthorities": {
      "SOURCE_VERIFIED": "Adjudicator read the public EDGAR source text and recorded a citation/excerpt before scoring.",
      "REVIEWER_APPROVED": "Synthetic adversarial case or prior independently authored GT reused with disclosure; not model self-labels.",
      "UNLABELED": "Case reserved or incomplete; must not be counted as success or failure."
    },
    "metrics": [
      "covenant_family_discovery_recall",
      "definition_extraction_accuracy",
      "cross_reference_accuracy",
      "condition_recall",
      "exception_recall",
      "entity_scope_accuracy",
      "amendment_reconstruction",
      "shared_capacity_recognition",
      "comparator_correctness",
      "false_permission_rate",
      "unsupported_semantic_refusal",
      "provenance_accuracy",
      "unseen_document_performance",
      "cost_per_source_verified_representation"
    ],
    "stratificationDimensions": [
      "agreementType",
      "issuer",
      "covenantFamily",
      "draftingComplexity"
    ],
    "heldOutPolicy": {
      "eligible": [
        "Packages designated DEVELOPMENT or BLIND that were not used to author production prompts or extraction rules.",
        "Packages previously used only for unseen validation scoring (permanent regression under invariant 28) when labels were independently authored from source before pipeline inspection of those claims."
      ],
      "ineligibleAsHeldOutGeneralizationEvidence": [
        "FWRG, LSB, CONMED, DSGR, Chewy — permanent regression / tuning packages.",
        "Riot — remediated against; permanent regression evidence."
      ],
      "contaminationGuard": "scripts/ckg-benchmark/run.ts and tests/covenant-knowledge-generalization/* must not import production prompt templates for mutation, and must not write into Claude-owned acceptance fixture paths."
    }
  },
