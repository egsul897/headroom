// NS-4 — historical draft. Applied to prisma/schema.prisma in slice 3
// (migration 20261009140000_ns4_contract_input_snapshots). Keep for reference.
// Distinct names from legacy FinancialSnapshot / financial_snapshots.

model ContractInputSnapshot {
  id                   String   @id @default(cuid())
  snapshotId           String   @unique
  companyId            String
  version              String
  asOf                 String?
  reportingPeriod      String?
  status               String // DRAFT | REVIEW_REQUIRED | APPROVED | SUPERSEDED
  supersedesSnapshotId String?
  provenanceJson       Json
  reviewedBy           String?
  reviewedAt           String?
  approvalRef          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  facts  ContractInputFact[]
  events ContractInputSnapshotEvent[]

  @@index([companyId, status])
  @@map("contract_input_snapshots")
}

model ContractInputFact {
  id           String @id @default(cuid())
  snapshotId   String
  identityJson Json
  valueJson    Json
  displayName  String?
  sourceVersion String?
  overridesDefinitionId String?
  note         String?

  snapshot ContractInputSnapshot @relation(fields: [snapshotId], references: [snapshotId], onDelete: Cascade)
  locators ContractInputFactLocator[]

  @@index([snapshotId])
  @@map("contract_input_facts")
}

model ContractInputFactLocator {
  id        String @id @default(cuid())
  factId    String
  sourceDocumentId String?
  sourceVersionHash String?
  locatorJson Json?

  fact ContractInputFact @relation(fields: [factId], references: [id], onDelete: Cascade)

  @@index([factId])
  @@map("contract_input_fact_locators")
}

model ContractInputSnapshotEvent {
  id         String   @id @default(cuid())
  eventId    String   @unique
  snapshotId String?
  companyId  String
  type       String // SNAPSHOT_APPENDED | SNAPSHOT_APPROVED | SNAPSHOT_SUPERSEDED
  at         DateTime
  payloadJson Json
  createdAt  DateTime @default(now())

  snapshot ContractInputSnapshot? @relation(fields: [snapshotId], references: [snapshotId], onDelete: SetNull)

  @@index([companyId, at])
  @@index([snapshotId])
  @@map("contract_input_snapshot_events")
}
