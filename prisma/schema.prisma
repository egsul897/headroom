/// Document structure graph (task §9): Document -> Article -> Section ->
/// Subsection -> Clause -> Subclause -> Proviso -> Exception -> Schedule ->
/// Exhibit, as a real self-referencing tree rather than DocumentChunk's flat
/// per-LLM-window shape (DocumentChunk is untouched - it remains the
/// extraction pipeline's own processing-window unit; DocumentNode is the
/// logical/citable hierarchy a ContractRule points back to).
model DocumentNode {
  id            String           @id @default(cuid())
  companyId     String
  documentId    String
  stableKey     String
  parentId      String?
  nodeType      DocumentNodeType
  heading       String?
  sectionRef    String?
  // Sibling order under the same parent - NOT a global document order.
  ordinal       Int              @default(0)
  charStart     Int?
  charEnd       Int?
  page          Int?
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parent   DocumentNode?  @relation("DocumentNodeChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children DocumentNode[] @relation("DocumentNodeChildren")

  rulesSourced          ContractRule[]
  definedTermsSourced   DefinedTermNode[]
  referencesFromHere    ContractReferenceEdge[] @relation("ContractReferenceSourceNode")
  referencesTargetingMe ContractReferenceEdge[] @relation("ContractReferenceTargetNode")
  amendmentEffects      AmendmentEffect[]

  @@unique([companyId, stableKey])
  @@index([companyId, documentId])
  @@index([parentId])
  @@map("document_nodes")
}

/// Document relationship graph (task §11) - AMENDS/RESTATES/SUPERSEDES/etc
/// between two documents. Deliberately separate from Document's own
/// supersedesDocumentId/effectiveFrom/effectiveTo (untouched above): those
/// three columns remain the ONE mechanism the LEGACY engine's
/// loadCompanyCovenantData reads for amendment precedence - this table is
/// the general-purpose graph for every OTHER document relationship the
/// legacy engine never needed to represent (GUARANTEES, SECURES,
/// INTERCREDITOR_WITH, section-level AMENDS effects, etc).
model DocumentRelationshipEdge {
  id               String                          @id @default(cuid())
  companyId        String
  sourceDocumentId String
  // Phase 2C (task §14): nullable so a relationship whose SOURCE is known
  // (e.g. "Amendment No. 3 amends something") but whose TARGET cannot be
  // deterministically or semantically resolved with adequate confidence can
  // still be persisted honestly as unresolved, rather than either being
  // dropped entirely (losing the lead) or attached to a guessed document
  // (task's own explicit "a missing edge is safer than a wrong one").
  targetDocumentId String?
  relationshipType DocumentRelationshipType
  effectiveDate    DateTime?
  sourceCitation   String?
  // Phase 2C: the raw, un-resolved description of what the target LOOKED
  // like in the source text (e.g. "the Credit Agreement dated as of March
  // 1, 2021") - preserved even when targetDocumentId stays null, so the
  // lead itself is never silently lost.
  targetHint       String?
  scopeNote        String?
  confidence       Float?
  reviewStatus     ExtractionCandidateReviewStatus @default(PENDING)
  // Phase 2C (task §14): RESOLVED/REVIEW_REQUIRED/UNRESOLVED, orthogonal to
  // reviewStatus (human-review workflow state) exactly the way
  // ContractReferenceEdge already separates `resolved`/`unresolvedReason`
  // from its own reviewStatus.
  resolved         Boolean                         @default(true)
  unresolvedReason String?
  // Phase 2C: free-text provenance of HOW this edge was determined
  // ("DETERMINISTIC_SUPERSEDES_FIELD" | "DETERMINISTIC_AMENDMENT_STATEMENT" |
  // "DETERMINISTIC_TITLE_DATE_MATCH" | "SEMANTIC_CLASSIFICATION" | "MANUAL") -
  // never branched on, matches Document.source's own free-text-provenance
  // convention rather than a new closed enum per resolution strategy.
  resolutionMethod String?

  createdAt DateTime @default(now())

  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceDocument Document  @relation("DocumentRelationshipSource", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  targetDocument Document? @relation("DocumentRelationshipTarget", fields: [targetDocumentId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([sourceDocumentId])
  @@index([targetDocumentId])
  @@map("document_relationship_edges")
}

/// Defined terms as first-class nodes (task §14) - never a plain string.
model DefinedTermNode {
  id                String                          @id @default(cuid())
  companyId         String
  documentId        String
  stableKey         String
  termName          String
  normalizedName    String
  sourceNodeId      String?
  definitionTextRef String?
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  reviewStatus      ExtractionCandidateReviewStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document   Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sourceNode DocumentNode? @relation(fields: [sourceNodeId], references: [id], onDelete: SetNull)

  dependenciesFrom       DefinedTermDependencyEdge[] @relation("DefinedTermDependencyFrom")
  dependenciesTo         DefinedTermDependencyEdge[] @relation("DefinedTermDependencyTo")
  referencedBy           ContractReferenceEdge[]     @relation("ContractReferenceTargetTerm")
  amendmentEffects       AmendmentEffect[]
  UnresolvedContractItem UnresolvedContractItem[]

  @@unique([companyId, stableKey])
  @@index([companyId, documentId])
  @@index([companyId, normalizedName])
  @@map("defined_term_nodes")
}

/// Defined-term dependency graph (task §15/§16). Exactly one of
/// toTermId/toSectionRef/toFinancialInputKey is set - enforced by a CHECK
/// constraint in this model's own migration (never silently ambiguous about
/// what a dependency edge points at).
model DefinedTermDependencyEdge {
  id                  String                   @id @default(cuid())
  companyId           String
  fromTermId          String
  dependencyType      DefinitionDependencyType
  toTermId            String?
  toSectionRef        String?
  toFinancialInputKey String?
  note                String?

  createdAt DateTime @default(now())

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromTerm DefinedTermNode  @relation("DefinedTermDependencyFrom", fields: [fromTermId], references: [id], onDelete: Cascade)
  toTerm   DefinedTermNode? @relation("DefinedTermDependencyTo", fields: [toTermId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([fromTermId])
  @@index([toTermId])
  @@map("defined_term_dependency_edges")
}

/// Cross-reference graph (task §17-19). An unresolved reference is
/// persisted here too (resolved: false), never dropped to a bare string.
model ContractReferenceEdge {
  id                   String                          @id @default(cuid())
  companyId            String
  sourceNodeId         String?
  sourceRuleId         String?
  referenceType        ContractReferenceType
  referenceText        String
  targetType           ContractReferenceTargetType
  targetRuleId         String?
  targetDocumentNodeId String?
  targetTermId         String?
  targetDocumentId     String?
  resolved             Boolean                         @default(false)
  unresolvedReason     String?
  impact               String?
  confidence           Float?
  reviewStatus         ExtractionCandidateReviewStatus @default(PENDING)
  // Phase 3F.1.4 (P1-9 remediation) - content-derived identity, populated
  // ONLY by persistStructuralReferences (lib/contract-model/compiler/
  // persistence.ts), the one caller of this model that produces
  // deterministic, replay-safe edges (documentId + sourceNode/targetNode
  // charStart + referenceText). Nullable because the OTHER creator of this
  // model - persistReferences, the LLM-CandidateContractReference path,
  // deliberately out of this remediation's scope - never sets it and has no
  // stable identity of its own; Postgres's unique index treats multiple NULLs
  // as non-colliding, so this never constrains that other, untouched path.
  stableKey            String?

  createdAt DateTime @default(now())

  company            Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceNode         DocumentNode?            @relation("ContractReferenceSourceNode", fields: [sourceNodeId], references: [id], onDelete: SetNull)
  sourceRule         ContractRule?            @relation("ContractReferenceSourceRule", fields: [sourceRuleId], references: [id], onDelete: Cascade)
  targetRule         ContractRule?            @relation("ContractReferenceTargetRule", fields: [targetRuleId], references: [id], onDelete: SetNull)
  targetDocumentNode DocumentNode?            @relation("ContractReferenceTargetNode", fields: [targetDocumentNodeId], references: [id], onDelete: SetNull)
  targetTerm         DefinedTermNode?         @relation("ContractReferenceTargetTerm", fields: [targetTermId], references: [id], onDelete: SetNull)
  targetDocument     Document?                @relation("ContractReferenceTargetDocument", fields: [targetDocumentId], references: [id], onDelete: SetNull)
  unresolvedItems    UnresolvedContractItem[]

  @@unique([companyId, stableKey])
  @@index([companyId])
  @@index([sourceRuleId])
  @@index([targetRuleId])
  @@index([companyId, resolved])
  @@map("contract_reference_edges")
}

/// The generalized rule model (task §6) - the ContractRule every future
/// compiler stage/evaluation harness/Ask Headroom/Dashboard query targets.
/// Preserves the existing Permission model exactly as-is (task §3) - see
/// lib/contract-model/compatibility.ts for the read-time projection from
/// Permission into this shape.
model ContractRule {
  id               String  @id @default(cuid())
  companyId        String
  sourceDocumentId String
  sourceNodeId     String?
  stableKey        String

  covenantFamily  CovenantFamily
  ruleType        ContractRuleType
  evaluationClass RuleEvaluationClass
  posture         ContractRulePosture @default(N_A)

  // Free-text, validated at the application boundary against the
  // ContractAction union (lib/contract-model/types.ts) rather than a Postgres
  // enum - task §7 is explicit this taxonomy must stay extensible without a
  // migration per new action verb.
  action String

  // Entity/subject scope (task §8) - reuses EntityClassTag exactly as
  // Permission.entityScope already does (see that enum's own comment).
  entityScope         EntityClassTag[]
  entityScopeExcluded EntityClassTag[]
  beneficiary         String?

  thresholdValue Decimal? @db.Decimal(18, 6)
  // Reuses lib/connectors/units.ts's FinancialUnit union, stored as a
  // validated string - never inferred from magnitude (this codebase's own
  // hard-won unit-safety rule, docs/vercel-ai-gateway-extraction.md's
  // sibling doc autonomous-ingestion-production-readiness fix).
  thresholdUnit  String?
  // Free-text calculation-kind descriptor (task §23 - "representability
  // first", not a full evaluator) - validated against
  // lib/contract-model/types.ts's CalculationRuleKind union where set.
  formulaRef     String?
  operator       String?

  // Structured-JSON-where-relational-querying-isn't-needed (task §6's own
  // explicit allowance) - each array element validated against
  // lib/contract-model/types.ts's ContractConditionSchema/ExceptionSchema.
  conditions Json?
  exceptions Json?

  sourceSectionRef String
  definedTermRefs  String[]

  // Operative-version model (task §12/§27, lib/contract-model/service.ts's
  // getOperativeContractualState) - the SAME mechanism Document.effectiveFrom/
  // effectiveTo already uses for the legacy engine's amendment precedence.
  // Superseding a rule means setting THIS rule's effectiveTo to the new
  // rule's effectiveFrom; supersededByRuleId itself is informational
  // provenance only ("this rule was replaced by that one") and is never
  // consulted by the operative-as-of-date filter, so a historical query
  // before the amendment's effective date still correctly resolves here.
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  supersededByRuleId String?

  coverageStatus ContractCoverageStatus          @default(NOT_TESTED)
  reviewStatus   ExtractionCandidateReviewStatus @default(PENDING)

  // Compiler/extraction origin metadata (task §6/§28/§63) - provider/model/
  // promptVersion/schemaVersion/candidateId. Never chain-of-thought.
  extractionOrigin Json?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceDocument   Document       @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  sourceNode       DocumentNode?  @relation(fields: [sourceNodeId], references: [id], onDelete: SetNull)
  supersededByRule ContractRule?  @relation("ContractRuleVersionChain", fields: [supersededByRuleId], references: [id], onDelete: SetNull)
  supersedesRules  ContractRule[] @relation("ContractRuleVersionChain")

  relationshipsFrom ContractRuleRelationship[] @relation("ContractRuleRelationshipFrom")
  relationshipsTo   ContractRuleRelationship[] @relation("ContractRuleRelationshipTo")
  referencesFrom    ContractReferenceEdge[]    @relation("ContractReferenceSourceRule")
  referencedBy      ContractReferenceEdge[]    @relation("ContractReferenceTargetRule")
  amendmentEffects  AmendmentEffect[]
  eventObligations  ContractEventObligation[]
  coverageRecords   ContractCoverageRecord[]
  unresolvedItems   UnresolvedContractItem[]

  @@unique([companyId, stableKey])
  @@index([companyId, covenantFamily])
  @@index([companyId, action])
  @@index([sourceDocumentId])
  @@map("contract_rules")
}

/// Unified rule relationship + dependency graph (task §20/§21 - deliberately
/// ONE edge table for both: a "dependency" like "debt permission requires a
/// leverage test" is representable as a REQUIRES-typed relationship, so this
/// phase does not introduce a second, overlapping edge table for the same
/// concept - see docs/contract-model-foundation-phase-b.md's own design-
/// decision note). Extends, never replaces, PermissionRelationship.
model ContractRuleRelationship {
  id               String                          @id @default(cuid())
  companyId        String
  fromRuleId       String
  toRuleId         String
  relationshipType ContractRuleRelationshipType
  parameter        Json?
  sourceSectionRef String?
  notes            String?
  confidence       Float?
  reviewStatus     ExtractionCandidateReviewStatus @default(PENDING)

  createdAt DateTime @default(now())

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromRule ContractRule @relation("ContractRuleRelationshipFrom", fields: [fromRuleId], references: [id], onDelete: Cascade)
  toRule   ContractRule @relation("ContractRuleRelationshipTo", fields: [toRuleId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([fromRuleId])
  @@index([toRuleId])
  @@map("contract_rule_relationships")
}

/// Amendment effect model (task §13) - representable once identified, no
/// autonomous amendment parsing yet (that is Phase C).
model AmendmentEffect {
  id                   String                          @id @default(cuid())
  companyId            String
  amendmentDocumentId  String
  effectType           AmendmentEffectType
  // Phase 2C (task §9): which OTHER document this amendment targets - was
  // absent before this phase (an amendment could only point at an
  // already-resolved ContractRule/DefinedTermNode/DocumentNode row in the
  // SAME company, never explicitly at the cross-document target itself).
  // Null when the target document cannot be resolved with adequate
  // confidence (task §14) - targetHint below preserves the raw lead either
  // way.
  targetDocumentId     String?
  targetRuleId         String?
  targetTermId         String?
  targetDocumentNodeId String?
  // Phase 2C: raw section-reference/defined-term-name text as it appeared
  // in the amendment ("Section 6.01", "the definition of Consolidated
  // EBITDA") - preserved even when the corresponding *Id FK above cannot be
  // resolved (the target document's own structural parse may not exist
  // yet, or the section/term may not yet exist as a persisted row), so a
  // modification candidate's target is never silently lost to an
  // unresolved FK the way it would be if only the FK field existed.
  targetSectionRef     String?
  targetDefinedTermRef String?
  effectiveDate        DateTime?
  description          String
  oldValueSnapshot     Json?
  newValueSnapshot     Json?
  sourceSectionRef     String?
  reviewStatus         ExtractionCandidateReviewStatus @default(PENDING)
  // Phase 2C (task §14) - RESOLVED/REVIEW_REQUIRED/UNRESOLVED signal,
  // orthogonal to reviewStatus, mirroring DocumentRelationshipEdge's own
  // new resolved/unresolvedReason pair above.
  resolved             Boolean                         @default(true)
  unresolvedReason     String?
  resolutionMethod     String?

  createdAt DateTime @default(now())

  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  amendmentDocument  Document         @relation("AmendmentEffectSourceDocument", fields: [amendmentDocumentId], references: [id], onDelete: Cascade)
  targetDocument     Document?        @relation("AmendmentEffectTargetDocument", fields: [targetDocumentId], references: [id], onDelete: SetNull)
  targetRule         ContractRule?    @relation(fields: [targetRuleId], references: [id], onDelete: SetNull)
  targetTerm         DefinedTermNode? @relation(fields: [targetTermId], references: [id], onDelete: SetNull)
  targetDocumentNode DocumentNode?    @relation(fields: [targetDocumentNodeId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([amendmentDocumentId])
  @@index([targetDocumentId])
  @@map("amendment_effects")
}

/// Event/obligation representation foundation (task §25) - representation
/// only, no scheduling/notification engine this phase.
model ContractEventObligation {
  id                   String                          @id @default(cuid())
  companyId            String
  stableKey            String
  sourceRuleId         String?
  eventType            String
  conditionDescription String?
  // "DAYS_AFTER_EVENT" | "FIXED_DATE" | "PERIODIC" - free text, validated at
  // the application boundary (lib/contract-model/types.ts), not a Postgres
  // enum, since this is representation scaffolding for a future obligations
  // engine this phase deliberately does not build (task §25's own "do NOT
  // build the full obligations engine in Phase B").
  deadlineKind         String
  deadlineDays         Int?
  deadlineDate         DateTime?
  requiredAction       String
  satisfactionState    ObligationSatisfactionState     @default(PENDING)
  sourceSectionRef     String?
  reviewStatus         ExtractionCandidateReviewStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceRule ContractRule? @relation(fields: [sourceRuleId], references: [id], onDelete: SetNull)

  @@unique([companyId, stableKey])
  @@index([companyId])
  @@map("contract_event_obligations")
}

/// Coverage foundation (task §45) - generalized, covenant-family/document/
/// rule-scoped coverage, distinct from the existing solver-specific
/// SolverCoverageDeclaration (untouched - see docs/contract-model-foundation-phase-b.md §U).
model ContractCoverageRecord {
  id             String                 @id @default(cuid())
  companyId      String
  documentId     String?
  covenantFamily CovenantFamily?
  ruleId         String?
  status         ContractCoverageStatus
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document Document?     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  rule     ContractRule? @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, covenantFamily])
  @@map("contract_coverage_records")
}

/// Generalized unresolved/review item model (task §46) - what a future
/// compiler stage populates; this phase provides the structure and a few
/// manually-constructed fixture rows only.
model UnresolvedContractItem {
  id                String                          @id @default(cuid())
  companyId         String
  itemType          UnresolvedContractItemType
  sourceRuleId      String?
  sourceTermId      String?
  sourceReferenceId String?
  description       String
  impact            String?
  blocking          Boolean                         @default(true)
  reviewStatus      ExtractionCandidateReviewStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceRule      ContractRule?          @relation(fields: [sourceRuleId], references: [id], onDelete: Cascade)
  sourceTerm      DefinedTermNode?       @relation(fields: [sourceTermId], references: [id], onDelete: Cascade)
  sourceReference ContractReferenceEdge? @relation(fields: [sourceReferenceId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, blocking])
  @@map("unresolved_contract_items")
}

// =============================================================================
// Phase C production contract compiler v1 (docs/phase-c-contract-compiler-v1.md)
// Staged, resumable compiler run/stage state machine - mirrors
// ExtractionRun/ExtractionStage's own real, already-shipped pattern exactly
// (same partial-failure/retry discipline: a FAILED stage's retry never
// disturbs a sibling COMPLETED stage's persisted output), extended with
// content hashing (inputHash/outputHash) for incremental recompilation and a
// richer stage vocabulary matching the compiler's 11 real stages. A "run" is
// scoped to one financing PACKAGE (one or more Documents), not one document -
// see ContractCompilerRunDocument.
// =============================================================================

enum ContractCompilerStageKind {
  STRUCTURE
  DEFINITIONS
  INVENTORY
  RULE_EXTRACTION
  DEPENDENCY_RESOLUTION
  RELATIONSHIPS
  AMENDMENTS
  VERIFICATION
  VALIDATION
  COVERAGE
  PROMOTION

  @@map("contract_compiler_stage_kind")
}

enum ContractCompilerStageStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  BLOCKED
  REVIEW_REQUIRED

  @@map("contract_compiler_stage_status")
}

/// One compiler run over one financing package (task §5/§6). `packageKey` is
/// a caller-supplied stable identifier for the package (never a raw cuid -
/// same stable-identity discipline as every other Phase B stableKey), so a
/// re-run of the same package resumes the same ContractCompilerRun row
/// rather than creating a duplicate.
model ContractCompilerRun {
  id            String @id @default(cuid())
  companyId     String
  packageKey    String
  promptVersion String
  schemaVersion String

  startedAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  company   Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents ContractCompilerRunDocument[]
  stages    ContractCompilerStage[]

  @@unique([companyId, packageKey])
  @@index([companyId])
  @@map("contract_compiler_runs")
}

/// Join table (task §69 - "compiler must not incorrectly merge distinct
/// legal authorities"): a package can span multiple real Documents (e.g. a
/// Credit Agreement + its Indenture + their Intercreditor Agreement), each
/// preserved as its own row, never flattened into the run itself.
model ContractCompilerRunDocument {
  id         String @id @default(cuid())
  runId      String
  documentId String

  run      ContractCompilerRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  document Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([runId, documentId])
  @@map("contract_compiler_run_documents")
}

/// One (runId, stage) row - the resumability/incremental-recompilation unit
/// (task §6/§7). `inputHash` is a content hash of everything the stage
/// actually read (source text + upstream stage outputs it depends on); the
/// orchestrator (lib/contract-model/compiler/orchestrator.ts) skips re-running
/// a COMPLETED stage whose freshly-computed inputHash still matches the
/// persisted one, and reruns it (never mutating sibling stages) the moment it
/// does not - the generalized version of C0's own resumable-JSON-log
/// discipline (scripts/run-phase-c0-analyzer.ts), now per-stage rather than
/// per-document.
model ContractCompilerStage {
  id           String                      @id @default(cuid())
  runId        String
  stage        ContractCompilerStageKind
  status       ContractCompilerStageStatus @default(PENDING)
  inputHash    String?
  outputHash   String?
  provider     String?
  model        String?
  attemptCount Int                         @default(0)
  error        String?
  // Real, never-fabricated telemetry (task §57) - {inputTokens, outputTokens,
  // latencyMs, retryCount, rateLimitFailures, calculatedCostUsd} per
  // lib/contract-model/analyzer/telemetry.ts's own AnalyzerCallTelemetry
  // shape, or null for a deterministic (non-LLM) stage.
  telemetry    Json?
  // Durable stage output (task §6 resumability) - lets a later stage, or a
  // resumed run, read what a completed stage actually produced without
  // re-running it. Same role ExtractionCandidate rows play for the older
  // six-stage pipeline, generalized to one JSON blob per compiler stage
  // rather than a normalized table per candidate kind, since each stage's
  // shape is already validated by its own Zod schema (lib/contract-model/compiler/schemas.ts)
  // before ever reaching this column.
  output       Json?
  startedAt    DateTime?
  completedAt  DateTime?

  run ContractCompilerRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stage])
  @@map("contract_compiler_stages")
}

// =============================================================================
// Phase 3F.1.5.R - explicit claim-level safe-failure architecture
// (docs/phase-3f1-5-r-residual-foundation/03-safe-failure-architecture.json).
//
// Responds to Evaluation Contract V3's verdict
// (EVALUATION_CONTRACT_V3_SAFETY_GATE_FAILED_REQUIRES_HUMAN_DECISION): rather
// than asking an evaluator to reconstruct "did Headroom safely surface this
// failure" indirectly from nearby pipeline artifacts, Headroom must now
// explicitly RECORD, as first-class persisted production state, every
// material contractual claim it encountered but could not safely promote
// into trusted semantic state (NO_SILENT_MATERIAL_FAILURE).
//
// Deliberately NOT a new invention from scratch (per this phase's own
// charter, "do not duplicate existing review models if one can be safely
// generalized"): the lifecycle/audit-trail shape below is the SAME proven
// pattern already shipped for ExtractionCandidate/CandidateReviewEvent
// (proposed value never overwritten, append-only decision log, reviewedBy
// never fabricated, REVIEW_REQUIRED baked into the status vocabulary) -
// generalized to the live contract-model compiler pipeline's own claim
// identity (semantic-coverage's MaterialSemanticUnit.semanticUnitId, the
// existing content-derived, sibling-safe identity already computed by
// lib/contract-model/compiler/semantic-coverage/**) rather than
// ExtractionCandidateKind's onboarding-specific candidate types, and FK'd to
// Company/Document directly rather than to the legacy, quarantined
// ContractCompilerRun/ContractCompilerStage pair above (orchestrator.ts's own
// header comment: "NOT repaired here - quarantine only").
//
// Distinct from LegalReviewRecord (an attorney's review of a golden-test/
// permission/legal conclusion) and from CandidateReviewEvent (the onboarding
// extraction pipeline's own review trail) - this is the compiler pipeline's
// OWN claim-level safe-failure signal, never a re-skin of either.
// =============================================================================

// Lifecycle status (task's "small compositional production status model" -
// deliberately NOT one state per reason, per the task's own instruction not
// to encode every failure reason into status).
enum ClaimReviewStatus {
  OPEN_REVIEW
  RESOLVED_ACCEPTED
  RESOLVED_REJECTED
  SUPERSEDED

  @@map("claim_review_status")
}

// Bounded, extensible reason CLASSES (task's own "prefer stable broad reason
// classes + structured metadata + rationale over hundreds of bespoke reason
// enums"). OTHER_REVIEW_REQUIRED is the deliberate escape hatch - a reason
// that doesn't fit the other 10 classes is never forced into a false fit.
enum ClaimReviewReasonCode {
  SEMANTIC_AMBIGUITY
  INSUFFICIENT_CONTEXT
  UNSUPPORTED_EXPRESSION
  CONFLICTING_SOURCE_EVIDENCE
  UNRESOLVED_CROSS_REFERENCE
  OPERATIVE_STATE_UNCERTAIN
  STRUCTURAL_INTEGRITY_RISK
  VERIFICATION_CONTRADICTION
  MISSING_REQUIRED_SEMANTIC_DIMENSION
  COMPILATION_FAILURE
  OTHER_REVIEW_REQUIRED

  @@map("claim_review_reason_code")
}

// Which live pipeline stage detected (or, for HUMAN_REVIEWER, resolved) the
// issue. Deliberately its own fresh enum, NOT a reuse of the legacy/
// quarantined ContractCompilerStageKind (RULE_EXTRACTION/DEPENDENCY_RESOLUTION/
// etc.) which belongs to orchestrator.ts's quarantined pipeline and does not
// name the live 2A-3E module boundaries this phase's failure-boundary
// forensics actually found (discovery, context-retrieval, amendment/
// operative-state, semantic compiler, semantic verifier, coverage auditor).
enum ClaimReviewPipelineStage {
  DISCOVERY
  CONTEXT_RETRIEVAL
  AMENDMENT_OPERATIVE_STATE
  SEMANTIC_COMPILER
  SEMANTIC_VERIFIER
  COVERAGE_AUDITOR
  UNSUPPORTED_EXPRESSION_HANDLING
  HUMAN_REVIEWER
  OTHER

  @@map("claim_review_pipeline_stage")
}

/// One row per distinct, deduplicated claim currently (or historically) known
/// to require review - task §11's "discovery -> compiler failure ->
/// verification failure may remain ONE open claim-level review item with
/// multiple observations, rather than three unrelated alerts." `claimKey` is
/// the stable, content-derived, sibling-safe pre-compilation claim identity
/// (see lib/contract-model/compiler/safe-failure/identity.ts) - reused
/// verbatim from semantic-coverage's own MaterialSemanticUnit.semanticUnitId
/// where a coverage audit has run, or the compiler's own candidateRef
/// fallback otherwise - never a freshly invented identity scheme (task §4's
/// own "do not use human-readable sectionRef alone as unique identity").
model ClaimReviewItem {
  id            String  @id @default(cuid())
  companyId     String
  packageKey    String?
  instrumentKey String?
  documentId    String

  claimKey         String
  structuralNodeId String?
  sectionRef       String?
  charStart        Int?
  charEnd          Int?
  covenantFamily   String?

  // SemanticUnitMateriality's own vocabulary (CRITICAL/MATERIAL/
  // REVIEW_UNCERTAIN/INFORMATIONAL) - a free string, not a duplicate Prisma
  // enum, so the two never drift out of sync with a second source of truth.
  materiality String

  status               ClaimReviewStatus     @default(OPEN_REVIEW)
  reasonCode           ClaimReviewReasonCode
  // Task §7's own "OTHER/unknown structured explanation where genuinely
  // necessary" - a bounded set of dimension-name strings (action/posture/
  // object/scope/threshold/metric/condition/exception/dependency/
  // cross-reference/temporal state/operative version/shared cap/builder-
  // grower mechanics/reclassification/OTHER), never required to be exhaustive.
  unresolvedDimensions String[]

  // The FIRST pipeline stage that ever detected this claim needed review -
  // convenience/query field; the full multi-stage history lives in
  // `observations` below and is never lost when a later stage also detects
  // the same underlying claim.
  originStage ClaimReviewPipelineStage

  // Real source text - never fabricated, never a paraphrase presented as a
  // quote (matches SemanticVerificationFinding.sourceEvidence's own
  // discipline).
  sourceEvidence String
  sourceCitation String?

  // The compiled/represented semantic object this claim's PARTIAL
  // representation (if any) produced - an IRRule/IRDefinition id, or a
  // semantic-coverage matchedIrId - null when nothing was ever compiled for
  // this claim at all.
  relatedSemanticObjectId String?
  operativeVersionRef     String?

  // Human/AI-readable why-review-required narrative - never a bare label
  // with no evidence trail (matches MaterialSemanticUnit.materialityReasoning's
  // own discipline).
  rationale String

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  resolvedAt     DateTime?
  // Never fabricated - same "no invented reviewer identity" discipline as
  // ExtractionCandidate.reviewedBy/LegalReviewRecord.reviewerName.
  resolvedBy     String?
  resolutionNote String?

  algorithmVersion String

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  observations ClaimReviewObservation[]
  decisions    ClaimReviewDecision[]

  // The dedup key (task §11/§6): at most one ClaimReviewItem row per
  // (companyId, claimKey) ever exists - a later pipeline run's detection for
  // the SAME claim identity updates/extends this row's observations rather
  // than creating a duplicate, and a claim's full history (including any
  // prior SUPERSEDED/RESOLVED_* lifecycle) survives under this same row
  // rather than forking into parallel records.
  @@unique([companyId, claimKey])
  @@index([companyId, status])
  @@index([documentId])
  @@index([companyId, materiality, status])
  @@map("claim_review_items")
}

/// Append-only log of every individual pipeline-stage DETECTION that
/// contributed evidence toward this claim needing review (task §11's
/// "preserve stage history internally"). Never mutated or deleted - a claim
/// re-detected at a later stage, or on a later pipeline run, always adds a
/// NEW observation row rather than overwriting a prior one.
model ClaimReviewObservation {
  id               String                   @id @default(cuid())
  reviewItemId     String
  stage            ClaimReviewPipelineStage
  reasonCode       ClaimReviewReasonCode
  detail           String
  // The exact compilerAlgorithmVersion/verifierAlgorithmVersion/
  // inventoryAlgorithmVersion (whichever stage-specific version applies) -
  // never omitted, so a later reproducibility check can tell which algorithm
  // version actually produced this observation.
  algorithmVersion String
  createdAt        DateTime                 @default(now())

  reviewItem ClaimReviewItem @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)

  @@index([reviewItemId])
  @@map("claim_review_observations")
}

enum ClaimReviewDecisionAction {
  ACCEPT
  REJECT
  SUPERSEDE
  REOPEN

  @@map("claim_review_decision_action")
}

/// Append-only resolution-lifecycle audit trail (task §12's "never a
/// permanent dead record... never delete history"), the same proven shape as
/// CandidateReviewEvent (previousStatus/newStatus bracket exactly what
/// changed, a later decision is always a NEW row).
model ClaimReviewDecision {
  id             String                    @id @default(cuid())
  reviewItemId   String
  action         ClaimReviewDecisionAction
  previousStatus ClaimReviewStatus
  newStatus      ClaimReviewStatus
  note           String?
  // Never fabricated - see ClaimReviewItem.resolvedBy's own comment. Null
  // for an automated (non-human) transition (e.g. a coverage re-run finding
  // the claim now fully represented).
  decidedBy      String?
  createdAt      DateTime                  @default(now())

  reviewItem ClaimReviewItem @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)

  @@index([reviewItemId])
  @@map("claim_review_decisions")
}

// ---------------------------------------------------------------------------
// Phase 3F.1.6.R Workstream F - the live contract-analysis orchestration
// boundary's own minimal run-tracking state (BLOCKER-10 remediation,
// docs/phase-3f1-6-r-blocker-remediation/16-live-analysis-idempotency.json).
//
// This is deliberately NOT a second ContractCompilerRun/ContractCompilerStage
// (that model belongs to the quarantined legacy Phase C pipeline -
// lib/contract-model/compiler/orchestrator.ts's own header comment - and is
// never reused for the new, live-wired pipeline this model tracks). It is
// also deliberately NOT a per-stage cache/resume table the way
// ContractCompilerStage is: every real pipeline stage this run composes
// (structural persistence, package-graph persistence, ClaimReviewItem
// recording) is already independently idempotent (upsert-by-stableKey or
// upsert-by-claimKey - see lib/contract-model/compiler/persistence.ts,
// package-graph/persistence.ts, safe-failure/service.ts's own header
// comments), so re-running this run's own body to completion after an
// interruption is always safe by construction; this row exists to make that
// run's own identity/status/audit trail explicit and queryable, not to cache
// intermediate stage output.
//
// Idempotency/identity (task's own "tenant + document/package version-or-
// hash + analysis algorithm version"): `packageKey` is a content-derived
// hash of this run's own sorted document-id set (lib/contract-model/analysis/identity.ts) -
// Document rows are immutable once created in this codebase (a re-upload of
// byte-identical content converges on the EXISTING row via
// lib/connectors/upload-connector.ts's own dedup contract, and there is no
// in-place "edit this document's text" mutation anywhere), so a document's
// id is already a safe, sufficient proxy for its content identity. Adding a
// genuinely new document to the analyzed set changes `packageKey`, which
// changes this row's own identity - "a new document version runs
// independently" - while re-running over the SAME document set resolves to
// the SAME row every time (the `@@unique` below), and bumping
// `analysisAlgorithmVersion` deliberately changes identity too, causing
// fresh, intentional reprocessing.
enum AnalysisRunStatus {
  PENDING
  RUNNING
  COMPLETED
  COMPLETED_WITH_REVIEW
  FAILED
  // Phase 3F.1.6.RX Workstream H (AUDIT-F3) - at least one instrument's own
  // analysis threw an unexpected, unhandled exception (NOT a compiled/
  // verified claim needing review - that is COMPLETED_WITH_REVIEW's own,
  // separate signal), while at least one OTHER instrument in the same run
  // completed successfully. Deliberately distinct from COMPLETED_WITH_REVIEW
  // (which means every instrument's own analysis genuinely finished, and
  // SOME of what it found needs human review) and from FAILED (which means
  // NO instrument produced usable output at all) - overloading either of
  // those to also mean "one instrument's code threw" would make "did every
  // instrument's analysis actually finish running?" unanswerable from
  // status alone. A PARTIAL run always has >=1 durable AnalysisRunIssue row
  // for THIS run (see that model's own header comment) - status alone says
  // WHETHER something failed; AnalysisRunIssue says WHAT and WHY.
  PARTIAL

  @@map("analysis_run_status")
}

model AnalysisRun {
  id        String @id @default(cuid())
  companyId String

  // Content-derived hash of this run's own sorted document-id set - see this model's own header comment. Never a human-chosen label. 
  packageKey               String
  // The exact document ids this run analyzed together, in the same sorted order packageKey was derived from - kept alongside the hash for direct queryability/debugging without re-deriving it. 
  documentIds              String[]
  // Bumping this intentionally changes this row's own unique identity (see @@unique below), causing a fresh AnalysisRun row and full reprocessing - the mechanism task step 5's "bumping the analysis algorithm version can intentionally cause reprocessing" requires. 
  analysisAlgorithmVersion String

  status       AnalysisRunStatus @default(PENDING)
  // Free-text stage name (e.g. "STRUCTURAL_ANALYSIS", "SEMANTIC_COVERAGE") - a plain string, not a closed enum, so a later stage can be added/renamed without a migration; this field is progress/observability state only, never consulted for correctness by any resume logic (see this model's own header comment on why full stage-level resume is out of this model's scope). 
  currentStage String?

  startedAt       DateTime?
  completedAt     DateTime?
  // Structured detail for a genuinely fatal (whole-run-aborting) failure only - never populated for an ordinary per-claim/per-candidate uncertainty, which routes to its own ClaimReviewItem instead of failing the run (task step 7's "no single generic fatal error"). Shape: { stage: string, message: string, errorClass: string }.
  fatalError      Json?
  // The count of OPEN_REVIEW ClaimReviewItem rows this run's own package/company scope had at completion - a convenience denormalization for run-listing UIs, always re-derivable from ClaimReviewItem itself.
  reviewItemCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Phase 3F.1.6.RX Workstream H additions - both scoped to THIS run's own
  // id (never cross-run), and both cleared/re-derived fresh at the start of
  // every re-entry of this SAME row (see service.ts's own re-entry
  // discipline) so a resolved-on-retry instrument never leaves a stale
  // issue row, and a superseded semantic-truth row from an abandoned
  // attempt is never confused with this run's own real output.
  issues               AnalysisRunIssue[]
  semanticTruthRecords SemanticTruthRecord[]

  // The dedup/idempotency key (this model's own header comment): at most one
  // AnalysisRun row ever exists per (companyId, packageKey,
  // analysisAlgorithmVersion) - a duplicate trigger for the SAME document
  // set under the SAME algorithm version always resolves to, and updates,
  // this SAME row rather than creating a second one.
  @@unique([companyId, packageKey, analysisAlgorithmVersion])
  @@index([companyId, status])
  @@map("analysis_runs")
}

/// Phase 3F.1.6.RX Workstream H (AUDIT-F3 - partial instrument failure
/// durability). A durable, queryable record of ONE instrument unit's own
/// unexpected, unhandled failure during one AnalysisRun - the fix for the
/// NO_SILENT_MATERIAL_FAILURE gap where a prior run could complete
/// COMPLETED/COMPLETED_WITH_REVIEW while an instrument's real failure
/// existed only in an in-memory array and a console log.
///
/// Lifecycle: rows for a given `runId` are cleared at the START of every
/// re-entry of that run (see lib/contract-model/analysis/service.ts's
/// startOrResumeAnalysisRun) and freshly re-populated only for instruments
/// that actually fail during THAT attempt - so a retried run whose
/// previously-failing instrument now succeeds leaves no stale issue row
/// behind, while an instrument that fails again on retry gets a fresh row
/// with this attempt's own real error detail. This mirrors
/// lib/contract-model/compiler/persistence.ts's own P1-9 tombstoning
/// discipline (delete-then-repopulate within one run's own scope), applied
/// here to a per-run rather than per-document scope.
model AnalysisRunIssue {
  id        String @id @default(cuid())
  runId     String
  companyId String

  instrumentKey String
  documentIds   String[]

  failedStage String
  errorClass  String
  // Bounded/sanitized - reuses the exact credential-redaction discipline
  // lib/contract-model/compiler/semantic/compile.ts's own sanitizeErrorMessage
  // already established for this codebase's other persisted error messages,
  // never a raw stack dump.
  message     String

  createdAt DateTime @default(now())

  run     AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // At most one issue row per (runId, instrumentKey) - a re-detection of the
  // SAME instrument failing again within the SAME attempt (should not
  // happen given the orchestrator's own per-instrument try/catch runs each
  // unit exactly once per attempt, but guarded here anyway) updates this row
  // rather than duplicating it.
  @@unique([runId, instrumentKey])
  @@index([companyId])
  @@index([runId])
  @@map("analysis_run_issues")
}

/// Phase 3F.1.6.RX Workstream H (AUDIT-F7 - no log-only failure). A durable
/// Postgres trace for an unexpected exception that occurred BEFORE
/// runContractAnalysis had enough identity to own/claim a real AnalysisRun
/// row (e.g. the initial Document query itself failing, a transient DB
/// connectivity failure, or an unexpected exception inside
/// startOrResumeAnalysisRun's own claim attempt) - the one class of failure
/// that could previously reach app/'s own runExtractionAction with NO
/// durable trace anywhere except a console.error. Every failure that DOES
/// have a real runId by the time it occurs is instead recorded on that
/// AnalysisRun's own `fatalError` column (see AnalysisRun's own header
/// comment) or, for a per-instrument failure, as an AnalysisRunIssue row
/// above - this table exists ONLY for the narrower pre-identity case, so a
/// genuine failure is never only a log line.
model AnalysisFailureLog {
  id                   String  @id @default(cuid())
  companyId            String
  triggeringDocumentId String?

  stage      String
  errorClass String
  message    String

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("analysis_failure_logs")
}

/// Phase 3F.1.6.RX Workstream H (AUDIT-F1). Which IR object this row is
/// durable state for - IRRule.ruleId or IRDefinition.definitionId
/// (lib/contract-model/ir/types.ts). Shared-capacity resources
/// (IRSharedCapacity) are not yet persisted here - see
/// 09-semantic-truth-persistence-design.json's own disclosed scope note.
enum SemanticTruthKind {
  RULE
  DEFINITION

  @@map("semantic_truth_kind")
}

/// Phase 3F.1.6.RX Workstream H (AUDIT-F1, this phase's own charter Section
/// 19 - "Trust gating"). Deliberately a SEPARATE dimension from IR's own
/// RepresentationSufficiency (COMPLETE/PARTIAL/AMBIGUOUS/UNSUPPORTED/
/// MISSING_CONTEXT/CONFLICTED, preserved verbatim in `sufficiency` below):
/// sufficiency asks "how completely was this represented," this asks
/// "is this representation currently allowed to be treated as trusted
/// current contract truth." A rule can be sufficiency=COMPLETE and
/// trustStatus=REVIEW_REQUIRED (the independent verifier has not yet run,
/// or found something to check) - COMPLETE representation is never, by
/// itself, proof of correctness (task's own "COMPLETE sufficiency faces
/// STRONGER scrutiny, never a free pass" - semantic-verification/types.ts).
///
///   COMPILED        - Phase 3B produced this rule/definition; independent
///                      verification (Phase 3C) has not run for it, or its
///                      candidate's verification result is absent. A real,
///                      disclosed "compiled but not yet independently
///                      checked" state - never silently promoted.
///   VERIFIED         - the candidate this object was compiled from reached
///                      VERIFIED_NO_MATERIAL_GAP_FOUND or
///                      VERIFIED_WITH_NON_MATERIAL_FINDINGS. The ONLY status
///                      downstream "current semantic contract truth" reads
///                      may treat as trusted (see service.ts's own
///                      getTrustedSemanticTruth, which filters on exactly
///                      this value).
///   REVIEW_REQUIRED  - verification ran but could not clear the candidate
///                      (REVIEW_REQUIRED/VERIFICATION_INCOMPLETE/
///                      VERIFICATION_FAILED/NOT_VERIFIED) - a real signal a
///                      human should look at, distinct from a hard
///                      contradiction.
///   CONTRADICTED     - verification found a MATERIAL_DISCREPANCY: the
///                      independent verifier affirmatively believes this
///                      representation does not faithfully match the real
///                      source. Never silently downgraded to
///                      REVIEW_REQUIRED - a materially wrong claim is a
///                      stronger, more urgent signal than an unresolved one.
///   UNSUPPORTED      - this specific rule/definition's own IR sufficiency
///                      is UNSUPPORTED (an IRUnsupportedExpression-shaped
///                      escape hatch, or the whole rule/definition itself is
///                      UNSUPPORTED) - mechanically never executable/
///                      trustable regardless of what verification found,
///                      since there is no faithful structured meaning to
///                      verify in the first place.
enum SemanticTruthTrustStatus {
  COMPILED
  VERIFIED
  REVIEW_REQUIRED
  CONTRADICTED
  UNSUPPORTED

  @@map("semantic_truth_trust_status")
}

/// Phase 3F.1.6.RX Workstream H (AUDIT-F1) - durable, versioned,
/// reloadable persistence for the compiled/verified semantic IR
/// (lib/contract-model/ir/types.ts's IRRule/IRDefinition) that, before this
/// workstream, existed only in-memory for the duration of one
/// runContractAnalysis call (19-contract-truth-ownership-map.json's own
/// disclosed "semantic claim truth: NONE, DURABLY, TODAY" finding, from the
/// prior BLOCKER-10 remediation phase).
///
/// PERSISTENCE SHAPE DECISION (see 09-semantic-truth-persistence-design.json
/// for the full rationale): `payload` is the ENTIRE serialized IRRule or
/// IRDefinition object as JSON, versioned by `payloadSchemaVersion`
/// (currently IR_SCHEMA_VERSION verbatim) - a V1 JSON-payload body, NOT a
/// fully-normalized relational AST across dozens of tables. Every field a
/// caller needs to QUERY (tenant/instrument/document scope, trust status,
/// algorithm/prompt versions, provenance) is still a real relational
/// column, never buried inside the JSON blob - only the recursive
/// expression tree itself (IRExpression, which can nest arbitrarily deep
/// and has no natural row-per-node shape that any current caller needs to
/// query into independently - see IRExpression's own module header on why
/// even the in-memory IR chose a tree over a graph at the expression level)
/// is opaque JSON. Deserializing `payload` with the matching
/// `payloadSchemaVersion` reproduces the exact in-memory IRRule/IRDefinition
/// object the compiler produced - a real "reload without rerunning AI"
/// contract, proven in
/// tests/contract-model/semantic-truth-persistence.test.ts's own
/// process-boundary-simulating test.
///
/// IDEMPOTENCY: keyed by (companyId, instrumentKey, kind, semanticObjectId).
/// `semanticObjectId` (IRRule.ruleId / IRDefinition.definitionId) is ITSELF
/// already stable and content-derived - lib/contract-model/ir/identity.ts's
/// computeRuleId/computeDefinitionId are pure functions of
/// (companyId, instrumentKey, sourceSectionRef/termName, a content
/// discriminator) and are NEVER derived from sufficiency, verification
/// status, or any other mutable field (that module's own header comment) -
/// so re-running analysis over unchanged source text always re-derives the
/// SAME ruleId/definitionId and this table upserts the SAME row rather than
/// duplicating it. `contentHash`/`version` exist purely to make a REAL
/// content change to an already-persisted logical rule/definition visible
/// (a new `version` and `updatedAt`) without treating a genuine no-op
/// re-verification (identical payload) as if new state had been produced -
/// mirroring package-graph/persistence.ts's own "no-op skip" discipline.
///
/// TRUTH OWNERSHIP (this phase's own charter Section 10; see
/// 17-truth-ownership.json for the full map): once this table is populated,
/// it is the SOLE authoritative store for durable CURRENT semantic contract
/// truth (a rule/definition's own compiled meaning) - the legacy
/// lib/extraction/** pipeline's ExtractionCandidate/ContractRule rows
/// remain their own valid, separate candidate-suggestion/compatibility
/// workflow and can never override a row here; see that document for why no
/// compatibility adapter was needed (the two pipelines' outputs do not
/// overlap in the same table).
model SemanticTruthRecord {
  id String @id @default(cuid())

  companyId     String
  // Nullable: a standalone-instrument analysis run (identity.ts's own
  // standaloneInstrumentKey) still has a real packageKey from the
  // orchestrator's own run identity - kept here purely as a convenience
  // denormalization for company-wide package-scoped queries, never the
  // identity key itself (instrumentKey + semanticObjectId already uniquely
  // scope this row within a company).
  packageKey    String?
  instrumentKey String
  // Nullable: an analysis run that failed before reaching this instrument
  // could not have produced this row in the first place, but a REPLAY of
  // this table's own row (e.g. a future migration/backfill tool) may
  // legitimately need to write a row with no live AnalysisRun to point at.
  // onDelete: SetNull - deleting an old AnalysisRun row (e.g. a future
  // retention policy) must never cascade-delete the durable semantic truth
  // it produced; only the provenance LINK to that specific run is lost, not
  // the trusted state itself.
  analysisRunId String?

  kind             SemanticTruthKind
  // The idempotency key alongside (companyId, instrumentKey, kind) - see
  // this model's own header comment on why this is already safe to key on
  // directly rather than a synthetic content hash.
  semanticObjectId String

  // Source provenance (task's own required field list).
  candidateRef     String?
  sourceDocumentId String
  sourceSectionRef String?
  sourceCitation   String?
  // Bounded excerpt (mirrors SourceProvenance.excerpt's own "never a
  // synthesized paraphrase" discipline) - never the full document text.
  sourceExcerpt    String?

  // Algorithm/prompt/tool version provenance (task's own required field
  // list) - reused verbatim from the real compiler/verifier version
  // constants, never re-derived or paraphrased.
  irSchemaVersion          String
  compilerAlgorithmVersion String
  compilerPromptVersion    String
  toolPolicyVersion        String
  // Null when independent verification never ran for this object's own
  // candidate (trustStatus is then COMPILED, never VERIFIED) - a real,
  // disclosed "not yet checked" state.
  verifierAlgorithmVersion String?
  verifierPromptVersion    String?

  // SemanticVerificationStatus's own vocabulary, preserved as a free string
  // (mirrors ClaimReviewItem.covenantFamily's own "free string, not a
  // duplicate Prisma enum" discipline, so the two never drift out of sync)
  // - null when verification never ran.
  verificationStatus String?
  // The trust-gating dimension (this model's own required field per this
  // phase's own charter Section 19) - see SemanticTruthTrustStatus's own
  // doc comment for the full taxonomy and downstream-read contract.
  trustStatus        SemanticTruthTrustStatus

  // IRRule/IRDefinition's own RepresentationSufficiency, preserved verbatim
  // (COMPLETE/PARTIAL/AMBIGUOUS/UNSUPPORTED/MISSING_CONTEXT/CONFLICTED) - a
  // separate axis from trustStatus (see SemanticTruthTrustStatus's own
  // header comment on why these are deliberately not merged).
  sufficiency        String
  sufficiencyReasons String[]

  // Operative-state lineage reference (task's own required field), reused
  // verbatim from IRRule.operativeLineage/OperativeLineageRef - null for an
  // instrument/provision never amended (a legitimate, honest state, not an
  // error - see OperativeLineageRef's own callers elsewhere in this
  // codebase for the same convention).
  operativeLineage Json?
  // Bounded summary of the independent verifier's own SemanticVerificationFinding[]
  // for this object's candidate (findingId/findingType/severity/
  // sourceCitation/verifierReasoning only - never the full finding's raw
  // proposedIrEvidence dump) - "verification status and findings/summary"
  // per this phase's own required field list. Null when verification never
  // ran (trustStatus COMPILED) or produced zero findings.
  findingsSummary  Json?

  // The full serialized IRRule or IRDefinition - see this model's own
  // header comment on the JSON-payload-body design decision.
  payloadSchemaVersion String
  payload              Json

  // sha256 of the canonical (sorted-key) serialization of `payload` - used
  // ONLY to detect a genuine content change on re-upsert (bump `version`)
  // versus an idempotent no-op re-persist of identical content (this
  // model's own header comment) - never itself a queried/business field.
  contentHash String
  version     Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  analysisRun AnalysisRun? @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)

  @@unique([companyId, instrumentKey, kind, semanticObjectId])
  @@index([companyId, trustStatus])
  @@index([companyId, instrumentKey])
  @@index([analysisRunId])
  @@map("semantic_truth_records")
}
