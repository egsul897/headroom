  SPRINGING_COVENANTS
  MFN_PRICING_PROTECTION
  SUBSIDIARY_DESIGNATIONS
  ENTITY_SCOPE_RESTRICTIONS
  AMENDMENT_WAIVER_CONSENT
  NOTICE_REQUIREMENTS
  QUALITATIVE_AFFIRMATIVE_COVENANTS
