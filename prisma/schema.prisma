generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Coarse, company-level onboarding lifecycle (docs/document-onboarding-pipeline-foundation.md).
// Deliberately coarse - "is this company usable yet, and how much" - not a
// substitute for the fine-grained per-document/per-stage state that already
// lives on ExtractionRun/ExtractionStage below. ACTIVE is the default so this
// migration leaves Coherent/Matthews' real state alone (both are already
// fully active, engineer-populated companies as of this migration).
enum OnboardingStatus {
  ONBOARDING
  ACTIVE_WITH_LIMITATIONS
  ACTIVE

  @@map("onboarding_status")
}

// Customer-workspace tenancy classification (docs/headroom-master-product-architecture.md).
// CUSTOMER: a real customer's workspace - the ONLY kind of company a normal
// customer-facing surface (the root landing resolver, the company nav's
// switcher) may show. EVALUATION: Coherent, Matthews, synthetic/test-fixture
// companies, and anything else that exists for regression/evaluation/
// architecture-validation purposes - reachable only via /admin. Defaults to
// CUSTOMER because the one company-creation path in the product
// (/companies/new, the onboarding wizard) is exactly how a real customer
// workspace gets provisioned; the migration that adds this column explicitly
// backfills every pre-existing row to EVALUATION (see that migration's own
// comment) so nothing already in the database is silently reclassified as a
// customer by this default.
enum CompanyTenantKind {
  CUSTOMER
  EVALUATION

  @@map("company_tenant_kind")
}

model Company {
  id         String            @id @default(cuid())
  name       String
  ticker     String?
  cik        String?
  tenantKind CompanyTenantKind @default(CUSTOMER)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  // Onboarding-pipeline additions (docs/document-onboarding-pipeline-foundation.md).
  // `currency`/`asOfDate` are company-level defaults a later phase's financial
  // onboarding can read without re-deriving them per FinancialState row.
  onboardingStatus OnboardingStatus @default(ACTIVE)
  currency         String?          @default("USD")
  asOfDate         DateTime?

  documents          Document[]
  covenantProvisions CovenantProvision[]
  financialSnapshots FinancialSnapshot[]
  debtTranches       DebtTranche[]
  ledgerEntries      LedgerEntry[]
  feedQueueItems     FeedQueueItem[]
  goldenTests        GoldenTest[]

  // --- Solver-native contract model (docs/solver-architecture-design.md §R) ---
  // Additive only. Zero rows for Coherent/any existing company as of this
  // migration - see docs/solver-implementation-phases-0-7-report.md. These
  // relations exist purely so the new tables have real referential integrity
  // to Company; nothing in the legacy engine (lib/covenant-engine.ts) reads
  // them.
  permissions                Permission[]
  permissionRelationships    PermissionRelationship[]
  sharedCapacityConstraints  SharedCapacityConstraint[]
  collateralPools            CollateralPool[]
  intercreditorAgreements    IntercreditorAgreement[]
  ruleActivationConditions   RuleActivationCondition[]
  entityClassMembers         EntityClassMember[]
  externalInputRecords       ExternalInputRecord[]
  solverCoverageDeclarations SolverCoverageDeclaration[]
  legalReviewRecords         LegalReviewRecord[]

  // --- Financial core (docs/generalized-financial-analytics-architecture.md §T) ---
  // Additive only, mirroring the solver-native model's own "zero rows for any
  // existing company as of this migration" posture. Nothing in the legacy
  // engine (lib/covenant-engine.ts) or the solver (lib/solver/**) reads these
  // tables; only lib/financial-core/** and lib/financial-core-db/** do.
  financialStates FinancialState[]
  facilities      Facility[]
  debtEvents      DebtEvent[]

  // --- Document onboarding pipeline (docs/document-onboarding-pipeline-foundation.md) ---
  // Additive only. Zero rows for Coherent/Matthews as of this migration - both
  // were populated by engineer scripts, not this pipeline. Nothing in
  // lib/covenant-engine.ts or lib/solver/** reads these tables; only
  // lib/extraction/** and lib/document-storage/** do.
  extractionRuns       ExtractionRun[]
  extractionCandidates ExtractionCandidate[]

  // --- Autonomous information retrieval, Phase A (docs/autonomous-retrieval-phase-a-foundation.md) ---
  // Additive only. Zero rows for Coherent/Matthews as of this migration -
  // nothing here is retroactively backfilled for either company. Nothing in
  // lib/covenant-engine.ts, lib/solver/**, or lib/onboarding/promotion.ts
  // reads these tables; only lib/connectors/** does. See SourceArtifact's own
  // comment for why FINANCIAL_FACT candidates still flow through the
  // pre-existing ExtractionCandidate/CandidateReviewEvent machinery rather
  // than a parallel one.
  sourceConnections   CompanySourceConnection[]
  sourceArtifacts     SourceArtifact[]
  ingestionJobs       IngestionJob[]
  sourcePriorityRules SourcePriorityRule[]

  // --- Phase B contract model foundation (docs/contract-model-foundation-phase-b.md) ---
  // Additive only. Zero rows for Coherent/Matthews as of this migration -
  // both remain fully served by the existing Permission/CovenantProvision
  // models; see lib/contract-model/compatibility.ts for the read-time
  // projection instead of a data migration.
  documentNodes              DocumentNode[]
  documentRelationshipEdges  DocumentRelationshipEdge[]
  definedTermNodes           DefinedTermNode[]
  definedTermDependencyEdges DefinedTermDependencyEdge[]
  contractReferenceEdges     ContractReferenceEdge[]
  contractRules              ContractRule[]
  contractRuleRelationships  ContractRuleRelationship[]
  amendmentEffects           AmendmentEffect[]
  contractEventObligations   ContractEventObligation[]
  contractCoverageRecords    ContractCoverageRecord[]
  unresolvedContractItems    UnresolvedContractItem[]

  // --- Phase C production contract compiler v1 (docs/phase-c-contract-compiler-v1.md) ---
  // Additive only. Zero rows for Coherent/Matthews as of this migration.
  contractCompilerRuns ContractCompilerRun[]
  DebtInstrument       DebtInstrument[]

  // --- Phase 3F.1.5.R explicit claim-level safe-failure architecture ---
  // Additive only. Zero rows for any company as of this migration.
  claimReviewItems ClaimReviewItem[]

  // --- Phase 3F.1.6.R Workstream F: live contract-analysis orchestration ---
  // Additive only. Zero rows for any company as of this migration.
  analysisRuns AnalysisRun[]

  // --- Phase 3F.1.6.RX Workstream H: durable semantic truth persistence,
  // partial-instrument-failure durability, and pre-identity failure trace ---
  // Additive only. Zero rows for any company as of this migration.
  semanticTruthRecords SemanticTruthRecord[]
  analysisRunIssues    AnalysisRunIssue[]
  analysisFailureLogs  AnalysisFailureLog[]

  @@map("companies")
}

enum DocumentType {
  CREDIT_AGREEMENT
  INDENTURE
  OTHER
  // Additive (docs/document-onboarding-pipeline-foundation.md), same pattern
  // as the ExternalInputKind.PUBLIC_FILING_RECONSTRUCTION addition
  // (prisma/migrations/20260825041936_add_public_filing_reconstruction_input_kind) -
  // Postgres ALTER TYPE ADD VALUE is additive only, no existing row affected.
  AMENDMENT
  INTERCREDITOR_AGREEMENT
  COMPLIANCE_CERTIFICATE
  // Phase 2C (docs/phase-2c-debt-package-graph.md §4) - additive, same
  // ALTER TYPE ADD VALUE safety as the block above. UNKNOWN is a real,
  // legitimate classification result (task §4 - "UNKNOWN with evidence is
  // preferable to fabricated certainty"), never a placeholder to migrate
  // away from.
  AMENDED_AND_RESTATED_AGREEMENT
  SUPPLEMENTAL_INDENTURE
  JOINDER
  SECURITY_AGREEMENT
  GUARANTEE
  SIDE_LETTER
  FEE_LETTER
  OTHER_DEBT_DOCUMENT
  UNKNOWN
  // Phase 2F.3 (docs/phase-2f3-package-graph-remediation.md §5/§12) -
  // additive, same ALTER TYPE ADD VALUE safety as every block above. Real
  // evidence (CONMED's own "Guarantee and Collateral Agreement") showed
  // GUARANTEE and SECURITY_AGREEMENT alone each drop half of a composite
  // document's real identity - this is a genuine, reusable leveraged-
  // finance document concept (a single agreement combining guaranty and
  // collateral/security grant provisions), not a CONMED-specific title.
  GUARANTEE_AND_SECURITY_AGREEMENT

  @@map("document_type")
}

// A credit document's structural capacity formulas, expressed as expression
// trees over its own CovenantProvision rows (see CapacityExpr / RpWaterfallConfig
// / AssetSaleConfig in lib/covenant-engine.ts). This is *composition* wiring
// ("secured capacity = min(these baskets stacked, this ceiling)") which is
// specific to how a given document's covenant package fits together - the
// individual basket sizes/ratios/percentages referenced by these formulas
// live in CovenantProvision rows below and are what actually varies per deal.
model Document {
  id         String       @id @default(cuid())
  companyId  String
  name       String
  type       DocumentType
  governs    String?
  executedOn DateTime?
  notes      String?

  // Effective-dating for amendment precedence. Both null = always effective
  // (the common case for an original, never-amended document). When an
  // amendment supersedes this document, set THIS document's effectiveTo to
  // the amendment's effectiveFrom - the load layer (loadCompanyCovenantData)
  // filters purely on these two columns; supersedesDocumentId below carries
  // NO filtering logic of its own, so there is no document-name/type special
  // case anywhere in the query path.
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  // Informational provenance only ("this document is Amendment No. 1 to X") -
  // not consulted by the load-time date filter.
  supersedesDocumentId String?

  // JSON-encoded CapacityExpr trees: { secured?: CapacityExpr, unsecured?: CapacityExpr }
  capacityFormulas Json?
  // JSON-encoded RpWaterfallConfig: { steps: {code}[], ratioGateCodeByKind: {dividend, investment} }
  rpWaterfall      Json?
  // JSON-encoded AssetSaleConfig: { thresholdCode: string, reinvestmentWindowDays: number }
  assetSale        Json?

  // --- Upload/storage/review-provenance (docs/document-onboarding-pipeline-foundation.md) ---
  // Deliberately separate from supersedesDocumentId/effectiveFrom/effectiveTo
  // above, which remain the ONLY amendment-precedence mechanism the engine's
  // load layer consults - these fields never feed loadCompanyCovenantData.
  //
  // storageRef/storageProvider are opaque references into whichever
  // DocumentStorageProvider (lib/document-storage/**) actually stored the
  // uploaded file's bytes - null for a document that was never uploaded
  // through the pipeline (every existing Coherent/Matthews row, as of this
  // migration).
  storageRef       String?
  storageProvider  String?
  originalFilename String?
  uploadedAt       DateTime?
  // Distinguishes how this row came to exist - "user-upload" for the new
  // pipeline, defaulted to "engineer-authored" by this migration for every
  // pre-existing row (Coherent/Matthews were populated by hand-written
  // population scripts, not a document upload).
  source           String    @default("engineer-authored")

  // Whether a human has confirmed the AI-proposed `type` /
  // `supersedesDocumentId` (STRUCTURE-stage ExtractionCandidate.kind =
  // DOCUMENT_RELATIONSHIP proposals - lib/extraction/provider.ts) as correct,
  // as opposed to those fields merely reflecting an unreviewed AI proposal -
  // the review discipline the task's own onboarding-pipeline brief requires.
  // Defaulted to true by this migration for every pre-existing row: Coherent/
  // Matthews' `type`/`supersedesDocumentId` were set directly by an engineer
  // reading the executed document, not proposed-then-reviewed, so they are
  // already "confirmed" in the sense this flag records.
  typeConfirmedByUser                  Boolean @default(true)
  amendmentRelationshipConfirmedByUser Boolean @default(true)

  // --- Phase 2C debt package graph (docs/phase-2c-debt-package-graph.md §7) ---
  // The instrument this document PRIMARILY defines or amends (a base Credit
  // Agreement, an Amendment to it, a Supplemental Indenture, etc) - null
  // when evidence is insufficient to group it (task §14's "a missing edge
  // is safer than a wrong one" applied to grouping too) OR when the
  // document is cross-cutting rather than instrument-defining (an
  // Intercreditor Agreement, a Guarantee spanning multiple facilities) -
  // those relate to instruments via DocumentRelationshipEdge (GOVERNS/
  // SECURES/GUARANTEES/INTERCREDITOR_WITH) to that instrument's own member
  // documents instead of a direct membership FK, so one cross-cutting
  // document can be associated with more than one instrument without a
  // second many-to-many table.
  instrumentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company                    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  instrument                 DebtInstrument?     @relation("DebtInstrumentDocuments", fields: [instrumentId], references: [id], onDelete: SetNull)
  baseDocumentForInstruments DebtInstrument[]    @relation("DebtInstrumentBaseDocument")
  supersedesDocument         Document?           @relation("DocumentSupersedes", fields: [supersedesDocumentId], references: [id], onDelete: SetNull)
  supersededBy               Document[]          @relation("DocumentSupersedes")
  covenantProvisions         CovenantProvision[]
  ledgerEntries              LedgerEntry[]
  definedTerms               DefinedTerm[]

  // Solver-native permissions sourced from this document (additive; see
  // Permission below). A document may have zero of these (legacy-only) or a
  // full complement (solver-native for the sides/grant types covered).
  permissions Permission[]

  // Document onboarding pipeline (see Company's own comment above for the
  // additive/zero-rows-for-existing-companies posture).
  chunks               DocumentChunk[]
  extractionRuns       ExtractionRun[]
  extractionCandidates ExtractionCandidate[]

  // Autonomous information retrieval, Phase A (docs/autonomous-retrieval-phase-a-foundation.md).
  // A SourceArtifact.documentId is set once a DOCUMENT artifact has been
  // materialized into this row - see SourceArtifact's own comment.
  sourceArtifacts SourceArtifact[]

  // Phase 3F.1.5.R explicit claim-level safe-failure architecture.
  claimReviewItems ClaimReviewItem[]

  // --- Phase B contract model foundation (docs/contract-model-foundation-phase-b.md) ---
  documentNodes                 DocumentNode[]
  definedTermNodes              DefinedTermNode[]
  contractRules                 ContractRule[]
  amendmentEffects              AmendmentEffect[]          @relation("AmendmentEffectSourceDocument")
  contractCoverageRecords       ContractCoverageRecord[]
  relationshipEdgesAsSource     DocumentRelationshipEdge[] @relation("DocumentRelationshipSource")
  relationshipEdgesAsTarget     DocumentRelationshipEdge[] @relation("DocumentRelationshipTarget")
  contractReferencesTargetingMe ContractReferenceEdge[]    @relation("ContractReferenceTargetDocument")

  // --- Phase C production contract compiler v1 (docs/phase-c-contract-compiler-v1.md) ---
  compilerRunDocuments ContractCompilerRunDocument[]

  // --- Phase 2C debt package graph (docs/phase-2c-debt-package-graph.md) ---
  amendmentEffectsTargetingMe AmendmentEffect[] @relation("AmendmentEffectTargetDocument")

  @@map("documents")
}

/// Debt-instrument grouping (task §7) - "Company -> Debt Package -> Debt
/// Instrument -> Documents". A "Debt Package" is deliberately NOT a new
/// persisted table here: it already exists as a ContractCompilerRun's own
/// (companyId, packageKey) + its ContractCompilerRunDocument member set
/// (see that model's own comment) - this phase reuses that identity rather
/// than inventing a second one. DebtInstrument is the one genuinely new
/// grouping layer: the underlying credit facility or note series that a
/// base agreement plus its amendments/joinders/supplements all belong to,
/// independent of whether any Facility (financial-core capital-structure
/// row, prisma/schema.prisma's own Facility model) has been populated for
/// it yet - this groups DOCUMENTS, not financial facts.
model DebtInstrument {
  id             String                          @id @default(cuid())
  companyId      String
  name           String
  instrumentType FacilityType?
  baseDocumentId String?
  confidence     Float?
  reviewStatus   ExtractionCandidateReviewStatus @default(PENDING)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  baseDocument Document?  @relation("DebtInstrumentBaseDocument", fields: [baseDocumentId], references: [id], onDelete: SetNull)
  documents    Document[] @relation("DebtInstrumentDocuments")

  @@index([companyId])
  @@map("debt_instruments")
}

// The generalized formula archetypes the engine knows how to evaluate.
// See lib/covenant-engine.ts for the per-type calculation and the FormulaParams
// each type reads out of CovenantProvision.params.
enum FormulaType {
  FLAT_AMOUNT
  FLAT_NET_OF_DEBT
  GREATER_OF_FLAT_OR_PCT_EBITDA
  LEVERAGE_RATIO_ROOM
  COVERAGE_RATIO_ROOM
  BUILDER_BASKET
  RATIO_GATE

  @@map("formula_type")
}

// One basket / covenant test, defined by data instead of hardcoded arithmetic.
// `code` is a stable machine key a document's capacityFormulas/rpWaterfall/
// assetSale JSON refers to; `thresholdValue` is the formula's primary numeric
// input (a ratio, a flat dollar amount, a required coverage multiple); `params`
// carries formula-specific secondary inputs (percentages, which leverage
// measure to use, etc).
model CovenantProvision {
  id             String      @id @default(cuid())
  companyId      String
  documentId     String
  code           String
  basketName     String
  sectionRef     String
  formulaType    FormulaType
  thresholdValue Decimal     @db.Decimal(18, 6)
  params         Json?
  notes          String?

  // Provision-level effective dating, for an amendment that changes only one
  // basket without replacing the whole document. Both null = effective for
  // the document's entire effective window. NOTE: (documentId, code) is
  // intentionally NOT a unique constraint anymore - a code legitimately
  // repeats across time-scoped versions (original + amended row). Postgres
  // unique constraints treat NULL as distinct from itself, so a composite
  // constraint including effectiveFrom could not actually prevent duplicate
  // never-amended rows either; correctness here is enforced by the load-time
  // date filter (at most one row per (documentId, code) can match a given
  // asOfDate if the data was entered without overlapping ranges), not by the
  // database. See loadCompanyCovenantData in lib/covenant-engine.ts.
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // The defined terms this provision's formula actually depends on (e.g. MILA's
  // secured prong depends on "Consolidated EBITDA" and "Consolidated Senior
  // Secured Net Leverage Ratio") - the backbone of the citation-to-text chain
  // the UI renders and the golden-test harness checks against
  // golden_tests.binding_defined_terms.
  definedTerms DefinedTerm[]

  @@index([documentId, code])
  @@map("covenant_provisions")
}

// Periodic financial inputs the engine's formulas run against.
model FinancialSnapshot {
  id                       String   @id @default(cuid())
  companyId                String
  asOfDate                 DateTime
  ebitda                   Decimal  @db.Decimal(18, 6)
  cash                     Decimal  @db.Decimal(18, 6)
  interestExpense          Decimal  @db.Decimal(18, 6)
  cumulativeNetIncome      Decimal  @db.Decimal(18, 6)
  equityProceedsSinceIssue Decimal  @db.Decimal(18, 6)
  assumedNewDebtRatePct    Decimal  @db.Decimal(9, 6)
  totalDebt                Decimal  @db.Decimal(18, 6)
  securedDebt              Decimal  @db.Decimal(18, 6)
  notes                    String?

  createdAt DateTime @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  debtTranches DebtTranche[]

  @@map("financial_snapshots")
}

// Individual debt instruments making up a FinancialSnapshot's totalDebt/
// securedDebt aggregates - kept as its own table purely for the Position
// tab's capital-structure display; the engine only ever reads the aggregates.
model DebtTranche {
  id                  String  @id @default(cuid())
  companyId           String
  financialSnapshotId String
  name                String
  amount              Decimal @db.Decimal(18, 6)
  secured             Boolean
  documentName        String?

  createdAt DateTime @default(now())

  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialSnapshot FinancialSnapshot @relation(fields: [financialSnapshotId], references: [id], onDelete: Cascade)

  @@map("debt_tranches")
}

enum LedgerBasket {
  EQUITY
  DEBT_INCUR
  DEBT_REPAY
  ASSET_SALE
  DIVIDEND
  INVESTMENT

  @@map("ledger_basket")
}

enum LedgerDirection {
  CREDIT
  DEBIT

  @@map("ledger_direction")
}

// Public-record / compliance-certificate events that draw on or add to basket
// capacity (equity raises, debt incurrence/repayment, asset-sale proceeds,
// dividends, investments).
model LedgerEntry {
  id          String          @id @default(cuid())
  companyId   String
  documentId  String?
  date        DateTime
  description String
  basket      LedgerBasket
  amount      Decimal         @db.Decimal(18, 6)
  direction   LedgerDirection
  source      String?

  createdAt DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@map("ledger_entries")
}

enum FeedQueueKind {
  // Approving creates a new FinancialSnapshot, merging payload fields onto the current latest one.
  SNAPSHOT_UPDATE
  // Approving creates a new LedgerEntry from the payload.
  LEDGER_ENTRY

  @@map("feed_queue_kind")
}

enum FeedQueueStatus {
  PENDING
  APPLIED
  DISMISSED

  @@map("feed_queue_status")
}

// A filing/feed event awaiting sign-off before it touches the model - the
// Feeds tab's review queue. `payload` is a FeedQueueSnapshotPayload or
// FeedQueueLedgerPayload (lib/coherent.ts) depending on `kind`; approving
// writes real FinancialSnapshot/LedgerEntry rows, which is why approving a
// queue item changes what Position/Simulate show.
model FeedQueueItem {
  id          String          @id @default(cuid())
  companyId   String
  title       String
  description String
  source      String
  filedDate   DateTime
  kind        FeedQueueKind
  payload     Json
  status      FeedQueueStatus @default(PENDING)
  resolvedAt  DateTime?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("feed_queue_items")
}

enum DefinedTermStatus {
  // Reconstructed/illustrative text, not yet checked against the executed document.
  UNVERIFIED
  // Checked against the executed document by a human reviewer.
  VERIFIED
  // A reviewer flagged the text as wrong or contested.
  DISPUTED

  @@map("defined_term_status")
}

// A defined term from a document's definitions section, with its actual text -
// the other half of "cite the section" (SectionRef): a lawyer can expand a
// provision's citation and read the definition itself, not just trust that a
// section number was matched correctly. `status` defaults to UNVERIFIED
// because this text is reconstructed from public summaries, not extracted
// from the executed indenture/credit agreement - see the seed data and the
// UI's "unverified" badge for how that's surfaced.
model DefinedTerm {
  id         String            @id @default(cuid())
  documentId String
  termName   String
  sectionRef String
  fullText   String
  status     DefinedTermStatus @default(UNVERIFIED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document   Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  provisions CovenantProvision[]

  @@unique([documentId, termName])
  @@map("defined_terms")
}

// The read-only, mechanically-executable form of a golden question: which
// existing engine capability to call, and with what arguments. `question` is
// the human-readable prose a lawyer reviews; queryType/queryParams is what
// `npm run golden-test` actually invokes. Never expands to a new engine
// capability on its own - every queryType maps onto a function the engine
// already has (see scripts/golden-test.ts).
enum GoldenQueryType {
  // queryParams: { metric: "totalNetLeverage" | "seniorSecuredNetLeverage" | "fixedChargeCoverage" }
  LEVERAGE_METRIC
  // queryParams: { documentId: string, provisionCode: string }
  PROVISION_CAPACITY
  // queryParams: { documentId: string, secured: boolean }
  DOCUMENT_CAPACITY
  // queryParams: { secured: boolean }
  CROSS_DOCUMENT_CAPACITY
  // queryParams: { amount: number, secured: boolean, metric: "overallCapacity" | "cleared" | "proFormaTotalNetLeverage" | "proFormaSeniorSecuredNetLeverage" | "proFormaFixedChargeCoverage" }
  DEBT_SIMULATION
  // queryParams: { documentId: string, amount: number, kind: "dividend" | "investment", metric: "remaining" | "cleared" | "poolUsed" | "proFormaTotalNetLeverage" }
  RP_SIMULATION
  // queryParams: { documentId: string, amount: number, reinvest: boolean, metric: "excessProceeds" | "offerTriggered" | "proFormaTotalNetLeverage" }
  ASSET_SALE_SIMULATION
  // Reclassification, LME/priority/intercreditor analysis, Restricted/Unrestricted
  // Subsidiary redesignation, or anything else explicitly out of scope: the
  // harness reports these as FLAGGED rather than attempting a calculation.
  OUT_OF_SCOPE

  @@map("golden_query_type")
}

// LAWYER_VERIFIED previously existed here and was removed (zero rows ever
// used it, confirmed before removal) - see docs/legal-review-status-model.md
// for how independent/outside-counsel provenance should be recorded instead
// (an additional LegalReviewRecord, never a required tier).
//
// 2026-08-25 FINAL POLICY (docs/legal-review-status-model.md, "Final legal
// review status instruction"): this value was FOUNDER_AND_PEER_REVIEWED
// until this date, requiring both the founder and a second attorney. The
// founder, Headroom's own controlling legal-review authority, superseded
// that requirement: for Headroom's internal product/development purposes, a
// legal conclusion the founder has personally reviewed and approved is
// VERIFIED - complete, with no additional peer/second-attorney/outside-
// counsel/independent-counsel requirement. Renamed via a proper Prisma
// migration (prisma/migrations/<timestamp>_rename_founder_and_peer_reviewed_to_verified);
// every row previously FOUNDER_AND_PEER_REVIEWED is now VERIFIED with no data
// loss (an enum value rename, not a data migration).
enum GoldenTestStatus {
  UNVERIFIED
  VERIFIED
  DISPUTED

  @@map("golden_test_status")
}

// One row of the permanent regression suite. `npm run golden-test` runs every
// row against the live engine + live database and reports PASS/FAIL against
// expectedAnswer (within tolerance) AND against bindingProvision/
// bindingDefinedTerms - so a change that gets the number right but cites the
// wrong basket, or drops a defined-term dependency, still fails.
model GoldenTest {
  id        String @id @default(cuid())
  companyId String

  // Stable, content-derived, company-scoped business identity - independent
  // of the database-generated `id` (cuid) and of anything mutable
  // (expectedAnswer/status/question wording). Format: "<companyId>:q<NN>"
  // (2-digit zero-padded), e.g. "coherent:q22", "matthews:q07" - see
  // docs/database-replay-safety.md §B for the full 48-row assignment table
  // and the rationale (a fresh `prisma migrate deploy` + reseed regenerates
  // every GoldenTest.id, which previously broke every review/reconciliation
  // script that hardcoded a specific cuid literal). Seed/population scripts
  // upsert on this key (never on `id`); historical review/reconciliation
  // scripts resolve the row's current `id` through this key instead of
  // assuming a fixed cuid. `id` remains the database primary key and the
  // relational identity every other table's foreign key/ref continues to
  // point at (e.g. LegalReviewRecord.reviewedArtifactRef still stores an
  // `id`) - this is a replayability fix, not a primary-key redesign.
  stableKey String @unique

  question String

  queryType   GoldenQueryType
  queryParams Json?

  // Null for OUT_OF_SCOPE rows, which the harness always reports as FLAGGED.
  expectedAnswer Decimal? @db.Decimal(18, 6)
  tolerance      Decimal? @db.Decimal(18, 6)

  // Expected to match the binding provision's `code`, `basketName`, or
  // `sectionRef` (see matchesBindingLabel in scripts/golden-test.ts).
  bindingProvision    String?
  bindingDefinedTerms String[]

  reviewerNotes String?
  status        GoldenTestStatus @default(UNVERIFIED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("golden_tests")
}

// =============================================================================
// Solver-native contract model
// docs/solver-architecture-design.md §R ("Proposed schema"), implemented here
// per Phase 1 of docs/solver-implementation-phases-0-7-report.md.
//
// Everything below is strictly additive: no existing model, column, or enum
// above this line is modified. Zero rows exist for Coherent or any other
// pre-existing company as a result of this migration - see the "Legacy
// compatibility requirement" in the implementation task and
// docs/solver-implementation-phases-0-7-report.md §M. `lib/covenant-engine.ts`
// does not read any table below; only the new `lib/solver/*` modules do.
//
// The strict migration boundary (a document/side is fully solver-native XOR
// fully legacy CapacityExpr, never mixed - design doc §Q.2/§Q.3) is enforced
// by SolverCoverageDeclaration + Permission.modelingStatus, evaluated by
// lib/solver/coverage.ts, not by anything in this schema file alone.
// =============================================================================

enum GrantType {
  DEBT_INCURRENCE
  LIEN

  @@map("grant_type")
}

enum AmountKind {
  FIXED
  INCURRENCE_BASED

  @@map("amount_kind")
}

// Whether a Permission slot required by a document/side's declared coverage
// model has actually been authored (MODELED) or is a deliberate placeholder
// acknowledging a real, applicable provision that has not been modeled yet
// (KNOWN_NOT_MODELED). The coverage gate (lib/solver/coverage.ts) treats any
// KNOWN_NOT_MODELED row within a declared-complete scope as disqualifying
// that scope from solver-native evaluation - see design doc §Q.2.
enum ModelingStatus {
  MODELED
  KNOWN_NOT_MODELED

  @@map("modeling_status")
}

// Mirrors CovenantProvision/Permission's existing MeasurementBasis concept
// (legal-model-remediation-design.md §3, carried through unchanged by both
// ontology rounds - design doc §J).
enum MeasurementBasis {
  CUMULATIVE_INCURRED
  CURRENTLY_OUTSTANDING
  NET_OF_REPAYMENT
  PREPAYMENT_CREDIT

  @@map("measurement_basis")
}

// design doc §C.3. UNKNOWN is the fail-closed default for an unestablished
// pairwise relationship - never inferred (lib/solver/graph.ts never treats a
// missing relationship as any of the other eight kinds).
enum StackingRelationshipType {
  CONCURRENT_DISREGARDED
  CONCURRENT_COUNTED
  ALTERNATIVE
  MUTUALLY_EXCLUSIVE
  AUTOMATIC_LINKED_PERMISSION
  EQUAL_AND_RATABLE_PULLUP
  PARAMETER_ADJUSTMENT_TRIGGER
  SHARED_CONSTRAINT_PARTICIPATION
  UNKNOWN

  @@map("stacking_relationship_type")
}

// design doc §G.
enum AggregationRule {
  NAMED_MEMBER_CLAUSES
  EXTERNAL_INSTRUMENT_BALANCE
  ENTITY_CLASS_FILTER

  @@map("aggregation_rule")
}

// design doc §H. PARI_PASSU's "with which group" is carried on
// PermissionCollateralScope.pariPassuWithGroupId, not as a parameterized enum
// value, so the enum itself stays a small closed set.
enum PriorityTier {
  FIRST
  SECOND
  PARI_PASSU
  UNSECURED

  @@map("priority_tier")
}

// design doc §C.1 / Round 2 §I. A small, company-scoped fact table (see
// EntityClassMember below) rather than a hardcoded list of real entity names.
enum EntityClassTag {
  BORROWER
  GUARANTOR_RS
  NON_GUARANTOR_RS
  FOREIGN_RS
  UNRESTRICTED_SUB
  SECURITIZATION_SUB
  IMMATERIAL_SUB
  // Additive (docs/contract-model-foundation-phase-b.md §E - entity/subject
  // scope). The solver-native model above only ever needed the seven
  // restricted/unrestricted/guarantor distinctions a debt/lien permission's
  // entityScope actually varies by; Phase B's generalized ContractRule
  // reuses this SAME enum (never a parallel one - see that doc's §U
  // compatibility mapping) for broader covenant families that also scope by
  // the parent entity, the full loan-party group, a materiality threshold,
  // or "no restriction, any subsidiary." Zero existing Permission rows
  // reference these - purely additive, no reinterpretation of the values
  // above.
  PARENT
  LOAN_PARTY
  MATERIAL_SUBSIDIARY
  ANY_SUBSIDIARY

  @@map("entity_class_tag")
}

// design doc §I.
enum RuleActivationEffect {
  APPLICABILITY
  PARAMETER_VALUE
  RETROACTIVE_REEXAMINATION

  @@map("rule_activation_effect")
}

// design doc §I `StatePredicate` kinds.
enum StatePredicateKind {
  POINT_IN_TIME
  CONTINUITY_WINDOW
  EVENT_TRIGGERED
  USAGE_LIMITED

  @@map("state_predicate_kind")
}

// design doc §K.
//
// PUBLIC_FILING_RECONSTRUCTION is DELIBERATELY NOT a stronger or weaker tier
// of CERTIFIED_EXTERNAL_INPUT - it is a different kind of thing, the same way
// legal-review status (GoldenTestStatus/LegalReviewStatus VERIFIED) is a
// different dimension from CERTIFIED_EXTERNAL_INPUT
// (docs/legal-review-status-model.md §5/§7). A value is CERTIFIED_EXTERNAL_INPUT
// only when it is sourced from a real customer's own certified record - a
// Compliance Certificate, an ERP-linked figure, a lender-delivered
// certificate line item. A value is PUBLIC_FILING_RECONSTRUCTION when it is
// a documented, source-cited reconstruction built from a company's public
// SEC filings (e.g. GAAP net income + tax + interest + D&A, plus disclosed
// non-cash/one-time addbacks, approximating a covenant-style Adjusted
// EBITDA the filing itself never states as a single reconciled figure).
//
// HARD RULE: PUBLIC_FILING_RECONSTRUCTION is valid ONLY for test/regression
// fixtures (Coherent's own seed data being the first and, as of this
// migration, only example - see docs/coherent-phase8-population-reconciliation.md
// §U). It must NEVER be used to represent a real customer's certified
// figure, and it must never be silently upgraded to CERTIFIED_EXTERNAL_INPUT
// - certification requires the customer's own certified source, which a
// public-filing reconstruction categorically is not and cannot become by
// being reviewed more carefully. Application code that treats
// PUBLIC_FILING_RECONSTRUCTION as satisfying a real customer's
// CERTIFIED_EXTERNAL_INPUT gate is a bug, not a judgment call.
enum ExternalInputKind {
  COMPUTABLE_FORMULA
  CERTIFIED_EXTERNAL_INPUT
  PUBLIC_FILING_RECONSTRUCTION
  DISCRETIONARY_CATCH_ALL
  HUMAN_CLASSIFICATION

  @@map("external_input_kind")
}

// The generalized replacement for the debt/lien-relevant subset of
// CovenantProvision (design doc §C.1) - NOT a mutation of CovenantProvision
// itself; a parallel, independently-populated table. `formulaType`/
// `thresholdValue`/`params` deliberately mirror CovenantProvision's own
// fields so the leaf calculation core (`evaluateProvision` in
// lib/covenant-engine.ts) can be reused verbatim (design doc §Q.1 - "Phase
// (1) - leaf calculation - is kept as-is and reused, not replaced").
model Permission {
  id         String     @id @default(cuid())
  companyId  String
  documentId String
  // Optional stable machine key for citation/joins in tests and fixtures -
  // NOT required to be unique across companies, mirroring CovenantProvision.code.
  code       String?
  grantType  GrantType
  amountKind AmountKind
  // What this permission permits, in plain terms - "incur debt", "secure debt on Pool A at first priority".
  action     String

  // EntityClassFilter (design doc §C.1): which entity classes this permission
  // admits. An empty array means "no entity-class restriction" (available to
  // any incurring entity) - lib/solver/graph.ts treats empty distinctly from
  // "unknown", which is why this is a required array column, not nullable.
  entityScope EntityClassTag[]

  // Leaf calculation (FormulaRef, design doc §C.1) - reuses the existing
  // FormulaType/params/thresholdValue shape verbatim.
  formulaType    FormulaType
  thresholdValue Decimal     @db.Decimal(18, 6)
  params         Json?

  // Heterogeneous, permission-specific predicate lists - deliberately JSON,
  // not tables, per design doc §R ("Deliberately not over-normalized").
  eligibilityConditions Json?
  termConditions        Json?

  measurementBasis MeasurementBasis

  // Provenance (task Phase 1: "every solver-native record must preserve...
  // source section; review/modeling status").
  sectionRef      String
  definedTermRefs String[]

  // Effective dating - same semantics as Document/CovenantProvision.
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  modelingStatus ModelingStatus    @default(KNOWN_NOT_MODELED)
  reviewStatus   DefinedTermStatus @default(UNVERIFIED)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  relationshipsFrom           PermissionRelationship[]         @relation("PermissionRelationshipFrom")
  relationshipsTo             PermissionRelationship[]         @relation("PermissionRelationshipTo")
  sharedConstraintMemberships SharedCapacityConstraintMember[]
  collateralScopes            PermissionCollateralScope[]
  ruleActivationConditions    RuleActivationCondition[]

  @@index([documentId, grantType])
  @@index([companyId])
  @@map("permissions")
}

// design doc §C.3 - a row connecting two Permission ids with its own
// citation. `groupKey` clusters >2-way ALTERNATIVE/MUTUALLY_EXCLUSIVE groups
// (every member relationship row in the same group shares the same key).
// `parameter` carries PARAMETER_ADJUSTMENT_TRIGGER's payload (e.g.
// { parameter: "couponPct", adjustmentBps: 50 }).
model PermissionRelationship {
  id               String                   @id @default(cuid())
  companyId        String
  fromPermissionId String
  toPermissionId   String
  relationshipType StackingRelationshipType
  groupKey         String?
  parameter        Json?
  sourceSectionRef String
  notes            String?

  createdAt DateTime @default(now())

  company        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromPermission Permission @relation("PermissionRelationshipFrom", fields: [fromPermissionId], references: [id], onDelete: Cascade)
  toPermission   Permission @relation("PermissionRelationshipTo", fields: [toPermissionId], references: [id], onDelete: Cascade)

  @@index([fromPermissionId])
  @@index([toPermissionId])
  @@index([groupKey])
  @@map("permission_relationships")
}

// design doc §G - adopted verbatim from the Round 2 §F/§L item 1 merge of
// "cross-document capacity reference" and "nested guarantor sub-cap" into one
// shape. Company-scoped, not document-scoped, by design.
model SharedCapacityConstraint {
  id                 String           @id @default(cuid())
  companyId          String
  name               String
  // Usually FIXED; capFormulaType/capParams allow a formula-derived cap
  // (design doc §G: "usually FIXED, occasionally itself formula-derived").
  capAmount          Decimal?         @db.Decimal(18, 6)
  capFormulaType     FormulaType?
  capParams          Json?
  aggregationRule    AggregationRule
  measurementBasis   MeasurementBasis
  followsRefinancing Boolean          @default(false)
  sourceSectionRef   String
  effectiveFrom      DateTime?
  effectiveTo        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company                          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members SharedCapacityConstraintMember[]

  @@index([companyId])
  @@map("shared_capacity_constraints")
}

// Join table (design doc §R: "the standard, correctly-normalized shape").
// Exactly one of permissionId / namedInstrument / entityClass is populated,
// matching whichever aggregationRule the parent constraint uses.
model SharedCapacityConstraintMember {
  id                    String          @id @default(cuid())
  constraintId          String
  permissionId          String?
  namedInstrument       String?
  entityClass           EntityClassTag?
  externalInstrumentRef String?

  constraint SharedCapacityConstraint @relation(fields: [constraintId], references: [id], onDelete: Cascade)
  permission Permission?              @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([constraintId])
  @@index([permissionId])
  @@map("shared_capacity_constraint_members")
}

// design doc §H.
model CollateralPool {
  id             String  @id @default(cuid())
  companyId      String
  name           String
  definedTermRef String?

  createdAt DateTime @default(now())

  company Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scopes  PermissionCollateralScope[]

  @@index([companyId])
  @@map("collateral_pools")
}

// The load-bearing normalization that makes "first-priority on Pool A,
// second-priority on Pool B, same permission" representable (design doc §H).
model PermissionCollateralScope {
  id                       String       @id @default(cuid())
  permissionId             String
  collateralPoolId         String
  priorityTier             PriorityTier
  pariPassuWithGroupId     String?
  intercreditorAgreementId String?

  permission             Permission              @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  collateralPool         CollateralPool          @relation(fields: [collateralPoolId], references: [id], onDelete: Cascade)
  intercreditorAgreement IntercreditorAgreement? @relation(fields: [intercreditorAgreementId], references: [id], onDelete: SetNull)

  @@index([permissionId])
  @@index([collateralPoolId])
  @@map("permission_collateral_scopes")
}

// design doc §H - stops deliberately at "does joinder exist as a
// precondition"; enforcement-regime fields (standstill, turnover, DIP
// subordination, etc.) are intentionally NOT modeled, matching the explicit
// Phase 1 scope boundary.
model IntercreditorAgreement {
  id        String @id @default(cuid())
  companyId String
  name      String
  // { poolId, counterpartyClass }[] - which pool(s)/creditor classes this
  // specific agreement governs.
  governs   Json

  createdAt DateTime @default(now())

  company          Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  collateralScopes PermissionCollateralScope[]

  @@index([companyId])
  @@map("intercreditor_agreements")
}

// design doc §I - one generalized shape for every dynamic-activation
// mechanic (step-up/cooldown, springing covenants, discharge/reinstatement,
// equity-cure usage limits). `predicateConfig` carries the kind-specific
// parameters (minConsecutivePeriods/periodUnit for CONTINUITY_WINDOW,
// sinceEvent/until for EVENT_TRIGGERED, maxUses/minSpacingPeriods for
// USAGE_LIMITED, a description for POINT_IN_TIME) rather than a table per
// kind, since these are heterogeneous and permission/section-specific.
model RuleActivationCondition {
  id                       String               @id @default(cuid())
  companyId                String
  permissionId             String?
  covenantSectionIds       String[]
  companyWide              Boolean              @default(false)
  predicateKind            StatePredicateKind
  predicateConfig          Json
  effect                   RuleActivationEffect
  parameterName            String?
  reversionPredicateConfig Json?
  sourceSectionRef         String

  createdAt DateTime @default(now())

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permission Permission? @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([permissionId])
  @@map("rule_activation_conditions")
}

// design doc §R - "a small fact table of Restricted Subsidiaries +
// EntityClass tag", shared by both Permission.entityScope matching and
// SharedCapacityConstraintMember's ENTITY_CLASS_FILTER aggregation.
model EntityClassMember {
  id          String         @id @default(cuid())
  companyId   String
  entityName  String
  entityClass EntityClassTag

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, entityName])
  @@map("entity_class_members")
}

// design doc §K - generalizes FinancialFieldProvenance to certified/
// discretionary external inputs (borrowing-base certificate line items,
// named reserves, the discretionary catch-all reserve).
model ExternalInputRecord {
  id           String            @id @default(cuid())
  companyId    String
  kind         ExternalInputKind
  name         String
  value        Decimal?          @db.Decimal(18, 6)
  asOfDate     DateTime?
  sourceRef    String?
  reviewStatus DefinedTermStatus @default(UNVERIFIED)
  // Periodic certificates are stale, not silently reused, past this window
  // (design doc §K).
  maxAgeDays   Int?

  // --- Financial-core provenance extension (design doc §M.2/§T) ---
  // §M.2/§T recommend extending this table over a parallel one, since the
  // shape (kind/value/asOfDate/sourceRef/reviewStatus/maxAgeDays) is already
  // identical to what a per-fact financial-core provenance row needs. Both
  // columns are nullable and additive; a row backing a solver ExternalInputs
  // certificate (the table's original use) leaves both null, exactly as
  // today. `fieldKey` names which FinancialState/Facility field this record
  // is the source for (e.g. "balanceSheetFacts.cash", "liquidityFacts.borrowingBaseValue").
  financialStateId String?
  facilityId       String?
  fieldKey         String?

  createdAt DateTime @default(now())

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialState FinancialState? @relation(fields: [financialStateId], references: [id], onDelete: Cascade)
  facility       Facility?       @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([financialStateId])
  @@index([facilityId])
  @@map("external_input_records")
}

// The explicit, human-attested "coverage model" the strict coverage gate
// (design doc §Q.2, lib/solver/coverage.ts) consults: a document/side is
// eligible to be considered solver-native ONLY when a declaration exists AND
// is marked complete AND every Permission row in its scope is MODELED (not
// KNOWN_NOT_MODELED). Absence of a declaration (the case for every existing
// document today, including all of Coherent's) always resolves to the legacy
// path - see lib/solver/coverage.ts for the exact predicate. `side` is a free
// string (not an enum) so it can mirror CapacityExpr's existing
// "secured"/"unsecured" vocabulary without a schema change if a future side
// value is needed.
model SolverCoverageDeclaration {
  id         String    @id @default(cuid())
  companyId  String
  documentId String
  side       String
  grantType  GrantType
  isComplete Boolean   @default(false)
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([documentId, side, grantType])
  @@map("solver_coverage_declarations")
}

// =============================================================================
// Legal-review provenance (docs/legal-review-status-model.md)
//
// This is a DIFFERENT dimension from DefinedTermStatus/GoldenTestStatus's
// existing UNVERIFIED/VERIFIED/DISPUTED-style fields, deliberately not
// collapsed into them (task instruction: "preserve distinctions... do not
// collapse these dimensions"):
//   - DefinedTerm.status / Permission.reviewStatus / ExternalInputRecord.reviewStatus
//     (DefinedTermStatus) record DATA FIDELITY - "has this row's own text/
//     value been checked against the executed document" - an engineering/
//     transcription check, not a legal-interpretation judgment.
//   - GoldenTest.status (GoldenTestStatus) records the legal-review state of
//     one specific golden question's conclusion.
//   - LegalReviewRecord (below) is the generalized, reusable provenance
//     record behind a GoldenTestStatus/other legal-conclusion promotion: WHO
//     reviewed WHAT, in what capacity, and when - independent of which
//     specific status enum the reviewed artifact happens to carry. A
//     GoldenTest or a load-bearing legal conclusion that isn't tied to any
//     single row (e.g. "clause 6/24/25 non-netting", which spans several
//     Permission rows and the fact of their NOT being connected by a
//     stacking relationship) can both point here.
// A LegalReviewRecord never substitutes for CERTIFIED_EXTERNAL_INPUT
// financial-data provenance (ExternalInputRecord) - legal review status and
// financial-data certification remain orthogonal (task §C/§H).
// =============================================================================

enum LegalReviewStatus {
  // No qualified legal review recorded for this artifact yet.
  UNVERIFIED
  // Substantively reviewed and approved by Headroom's founder (an
  // experienced leveraged/debt-finance attorney), who is Headroom's own
  // authorized legal-review standard for internal product/development
  // purposes. Complete legal-review state on its own - no additional
  // peer-attorney, outside-counsel, or independent-counsel requirement
  // (docs/legal-review-status-model.md, "Final legal review status
  // instruction", 2026-08-25, superseding the prior two-reviewer
  // FOUNDER_AND_PEER_REVIEWED framework this value was renamed from - a
  // rename, not a data migration; no row or record was lost).
  // Orthogonal to financial-data provenance (ExternalInputRecord/
  // CERTIFIED_EXTERNAL_INPUT) and to engineering/implementation correctness
  // (a VERIFIED legal conclusion can still expose a CONFIGURATION_ERROR/
  // ENGINE_BUG in how it's implemented - see docs/legal-review-status-model.md §7/§9).
  VERIFIED
  // A reviewer flagged the reviewed conclusion as wrong or contested.
  DISPUTED

  @@map("legal_review_status")
}

// What kind of thing a LegalReviewRecord's reviewedArtifactRef points at.
// Deliberately a free-form-paired enum + string (like RuleActivationCondition's
// covenantSectionIds) rather than a set of nullable FK columns, because a
// reviewed conclusion legitimately spans zero, one, or several rows across
// different tables (e.g. the clause 6/24/25 non-netting conclusion is a
// property of an ABSENCE of a PermissionRelationship row, not any one row).
enum ReviewedArtifactType {
  GOLDEN_TEST // reviewedArtifactRef = GoldenTest.id
  PERMISSION // reviewedArtifactRef = Permission.id or .code
  RULE_ACTIVATION_CONDITION // reviewedArtifactRef = RuleActivationCondition.id
  // A conclusion that is not one single row - e.g. a stacking/non-netting
  // determination spanning several Permission rows, or a legal-definition
  // conclusion (EBITDA addback-cap absence) spanning a document's baskets.
  // reviewedArtifactRef is then a stable, human-readable conclusion slug.
  LEGAL_CONCLUSION

  @@map("reviewed_artifact_type")
}

model LegalReviewRecord {
  id                   String               @id @default(cuid())
  companyId            String
  reviewedArtifactType ReviewedArtifactType
  reviewedArtifactRef  String
  reviewStatus         LegalReviewStatus    @default(UNVERIFIED)

  // Reviewer metadata (task: "use actual reviewer metadata supplied by the
  // user/repository... DO NOT invent names, roles, or dates"). All three are
  // nullable and, as of this migration, are left null for every row - see
  // docs/legal-review-status-model.md and the population script's own
  // header comment for why: this task was given a review DETERMINATION
  // (founder-and-peer review occurred) but not the reviewers' names, their
  // exact titles, or the review date, so those fields are left for a future
  // update rather than fabricated.
  reviewerName       String?
  reviewerRole       String?
  reviewerExperience String?
  reviewDate         DateTime?

  notes         String?
  // Applicable source/version where relevant (e.g. a stacking-table or
  // blocker-closure document filename, a document's effective version).
  sourceVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([reviewedArtifactType, reviewedArtifactRef])
  @@map("legal_review_records")
}

// =============================================================================
// Financial core (docs/generalized-financial-analytics-architecture.md §T,
// Phase 1 of the vertical-slice implementation).
//
// Additive only. Zero rows for Coherent/any existing company as of this
// migration. Only lib/financial-core/** and lib/financial-core-db/** read or
// write these tables - lib/covenant-engine.ts and lib/solver/** are
// untouched (design doc §S.1's one-directional dependency).
//
// Scope note (minimum slice, task §4): this migration implements exactly the
// tables Phases 1-9 need (FinancialState, Facility, DebtEvent, plus the
// additive ExternalInputRecord extension above). ForecastSet, a persisted
// Scenario table, and FactConflict are named in the design doc's §T but
// explicitly deferred past this MVP slice (design doc §W/§X) - not built
// here. AmortizationSchedule is likewise not a separate table for this slice;
// the interest/maturity engines operate on Facility's own coupon/maturity
// fields directly (a pragmatic, bullet-maturity-first model - design doc §H's
// "pragmatic interest model" instruction), which is sufficient for every
// synthetic fixture and test case this task requires. See
// docs/financial-core-vertical-slice-implementation.md §W for the full
// deferred-capability list.
// =============================================================================

enum PeriodType {
  ACTUAL
  FORECAST
  PRO_FORMA

  @@map("period_type")
}

enum FacilityType {
  TERM_LOAN
  REVOLVER
  NOTES
  ABL
  OTHER

  @@map("facility_type")
}

enum CouponType {
  FIXED
  FLOATING

  @@map("coupon_type")
}

// Design doc §E.1's own enum, plus two additive members (LC_ISSUANCE/
// LC_EXPIRATION) needed by the ABL/LC synthetic fixture (task §20) to track
// letter-of-credit usage as its own event stream, distinct from principal
// draws/repayments - "amount" on an LC event is the signed LC-usage delta,
// never conflated with the principal `amount` sign convention ISSUANCE/
// REPAYMENT use (design doc §E.1: "sign convention by eventType, never
// overloaded").
enum DebtEventType {
  ISSUANCE
  REPAYMENT
  REFINANCING
  REDESIGNATION
  RECLASSIFICATION
  AMENDMENT
  LC_ISSUANCE
  LC_EXPIRATION

  @@map("debt_event_type")
}

// design doc §C - the canonical, company-agnostic point-in-time (or period)
// financial position. Fact groups are stored as JSON, each value shaped as a
// ProvencancedFact<T> (lib/financial-core/types.ts) - i.e. { value,
// sourceType, reviewStatus, asOfDate, staleness?, notes? } - never a bare
// number. This keeps every material fact's own provenance travelling with
// it, satisfying task §18's "every material derived output must be able to
// identify its material dependencies" without a fourth join table for this
// slice (see the ExternalInputRecord extension above for facts that also
// need independent per-fact staleness/citation lifecycle beyond what the
// embedded wrapper itself carries).
model FinancialState {
  id         String     @id @default(cuid())
  companyId  String
  asOfDate   DateTime
  periodType PeriodType @default(ACTUAL)
  // design doc §C.1 EntityScopeRef - "CONSOLIDATED" (default) or a specific
  // EntityClassTag subset, encoded as a free string so it never needs a
  // schema change to add a new scope shape.
  scope      String     @default("CONSOLIDATED")

  effectiveFrom DateTime?
  effectiveTo   DateTime?

  // { cash, restrictedCash?, totalAssets?, totalDebtPrincipal, securedDebtPrincipal, totalEquity? }
  balanceSheetFacts    Json
  // { revenue?, gaapEbitda?, gaapNetIncome?, cumulativeNetIncomeSinceIssue, equityProceedsSinceIssue, interestExpense, capex? }
  incomeStatementFacts Json
  // { covenantEbitda?: { value, addbacks: [...], provenance }, assumedNewDebtRatePct }
  covenantMetricFacts  Json
  // Additive extension beyond design doc §C.1's three fact groups, needed by
  // the liquidity engine (§F) for revolver/ABL-specific facts the product
  // acceptance target (task §2) requires that don't fit balance-sheet/
  // income-statement/covenant-metric categories: { revolverFacilityId?,
  // revolverCommitment?, revolverDrawn?, revolverLcUsage?, borrowingBaseValue? }.
  // Optional and nullable - a FinancialState with no revolver/ABL simply
  // omits it.
  liquidityFacts       Json?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalInputRecords ExternalInputRecord[]

  @@index([companyId, asOfDate])
  @@index([companyId, periodType])
  @@map("financial_states")
}

// design doc §D - a durable, company-scoped capital-structure instrument
// with its own identity across time (replaces DebtTranche's *display* role
// for financial-core consumers; DebtTranche itself is untouched - design doc
// §D.1).
model Facility {
  id           String       @id @default(cuid())
  companyId    String
  name         String
  facilityType FacilityType
  currency     String       @default("USD")

  // For TERM_LOAN/NOTES: the originally-issued principal. For REVOLVER/ABL:
  // informational only (commitmentAmount is the operative ceiling) - kept
  // non-null for schema simplicity, set equal to commitmentAmount for those
  // facility types by convention.
  originalPrincipal          Decimal  @db.Decimal(18, 6)
  // REVOLVER/ABL only: total commitment. Null for TERM_LOAN/NOTES.
  commitmentAmount           Decimal? @db.Decimal(18, 6)
  // ABL only: the most recently certified borrowing-base value, when known
  // as a static fact on the facility itself (as opposed to a per-date
  // ExternalInputRecord-backed FinancialState.liquidityFacts.borrowingBaseValue,
  // which is the authoritative as-of-date figure the liquidity engine
  // actually reads - design doc §F.1). Kept here only as an originationtime
  // reference value; may be null.
  borrowingBaseAtOrigination Decimal? @db.Decimal(18, 6)

  secured       Boolean
  couponType    CouponType
  couponPct     Decimal?   @db.Decimal(9, 6) // FIXED
  marginBps     Int? // FLOATING, over referenceRate
  referenceRate String? // e.g. "SOFR" - free text, never branched on
  rateFloorPct  Decimal?   @db.Decimal(9, 6) // FLOATING floor, where modeled

  maturityDate DateTime?
  issuedDate   DateTime?

  governingDocumentId String?

  obligorEntityClasses     EntityClassTag[]
  guarantorEntityClasses   EntityClassTag[]
  collateralPoolIds        String[]
  // design doc §D.2 - citation into the solver's own PermissionPath legs
  // that authorized this facility's incurrence, never re-derived.
  originatingPermissionIds String[]

  effectiveFrom DateTime?
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  debtEvents           DebtEvent[]
  externalInputRecords ExternalInputRecord[]

  @@index([companyId])
  @@map("facilities")
}

// design doc §E - the financial core's own capital-structure event log,
// facility-scoped and richer than LedgerEntry (which is untouched - design
// doc §E.2).
model DebtEvent {
  id         String        @id @default(cuid())
  companyId  String
  facilityId String
  eventType  DebtEventType
  date       DateTime
  // Principal (or, for LC_ISSUANCE/LC_EXPIRATION, LC-usage) effect. Sign
  // convention by eventType, never overloaded (design doc §E.1): ISSUANCE/
  // LC_ISSUANCE positive; REPAYMENT/LC_EXPIRATION positive-magnitude
  // reductions (subtracted by the replay logic, never stored negative).
  amount     Decimal       @db.Decimal(18, 6)

  refinancesFacilityId String?
  relatedPermissionIds String[]
  sourceLedgerEntryId  String?

  // The amount's own source/certification, ProvenanceWrapper-shaped (design
  // doc §E.1's `provenance: ProvencancedFact<number>`), stored as JSON for
  // the same reason FinancialState's fact groups are - a single wrapper
  // shape reused everywhere (design doc §M.1).
  provenance Json

  createdAt DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([facilityId, date])
  @@map("debt_events")
}

// =============================================================================
// Document onboarding pipeline - Phase 1 (docs/document-onboarding-pipeline-foundation.md)
//
// UPLOAD -> PARSE -> EXTRACT -> REVIEW -> APPROVE -> PROMOTE -> ACTIVATE. This
// migration builds the foundation only: storage, parsing/chunking, staged
// LLM extraction, and candidate persistence (lib/document-storage/**,
// lib/extraction/**). It deliberately stops at ExtractionCandidate -
// reviewStatus PENDING - and never writes a real Permission/
// PermissionRelationship/SharedCapacityConstraint/etc. row. Promotion (the
// transaction that turns an APPROVED candidate into a real row) is Phase 2's
// job, not this migration's or lib/extraction/**'s.
//
// Additive only. Zero rows for Coherent/Matthews as of this migration - see
// Company's own "Document onboarding pipeline" comment above. Nothing in
// lib/covenant-engine.ts or lib/solver/** reads any table below.
// =============================================================================

// One section/heading-scoped slice of a parsed document (lib/extraction/chunk.ts),
// with enough locational provenance (page/article/section/heading/char
// offsets) that a reviewer - or an ExtractionCandidate's sourceExcerpt - can
// point back at exactly where a proposal came from without re-parsing the
// source file. Deliberately NOT a vector-embeddings/retrieval-index table
// (task: "not infrastructure for its own sake") - `chunkIndex` gives stable
// ordering and that is the whole of this table's retrieval story.
model DocumentChunk {
  id         String  @id @default(cuid())
  documentId String
  chunkIndex Int
  page       Int?
  articleRef String?
  sectionRef String?
  heading    String?
  text       String
  charStart  Int?
  charEnd    Int?

  createdAt DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_chunks")
}

// The staged-extraction pipeline's own stage vocabulary (lib/extraction/provider.ts's
// ContractExtractionProvider methods, one per value) and each stage's
// candidate-kind mapping is documented on ExtractionCandidateKind below.
enum ExtractionStageKind {
  STRUCTURE
  DEFINITIONS
  PERMISSIONS
  RELATIONSHIPS
  COVERAGE
  FINANCIAL_INPUTS

  @@map("extraction_stage_kind")
}

enum ExtractionStageStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
  FAILED

  @@map("extraction_stage_status")
}

// One provider/model/prompt-version-pinned pass over a single document.
// `documentId` is the one document this run's chunks are read from; the
// RELATIONSHIPS/COVERAGE stages additionally read across every
// ExtractionCandidate already persisted for the company (not just this run's)
// when building their own stage input (lib/extraction/run-stage.ts) - a
// company can have several runs (one per document) whose candidates all
// participate in that company-wide cross-referencing.
model ExtractionRun {
  id            String @id @default(cuid())
  companyId     String
  documentId    String
  provider      String
  model         String
  promptVersion String
  schemaVersion String

  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document   Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  stages     ExtractionStage[]
  candidates ExtractionCandidate[]

  @@index([companyId])
  @@index([documentId])
  @@map("extraction_runs")
}

// One (extractionRunId, stage) row - the unit of partial-failure/retry
// (task §18: "a failure in one category should not destroy completed work").
// `runExtractionStage`/retry (lib/extraction/run-stage.ts) update this row in
// place; the unique constraint below is what makes a retry an UPDATE, never
// a duplicate INSERT, and what lets a FAILED stage's own retry leave every
// sibling stage's COMPLETE row (and its persisted candidates) untouched.
model ExtractionStage {
  id              String                @id @default(cuid())
  extractionRunId String
  stage           ExtractionStageKind
  status          ExtractionStageStatus @default(PENDING)
  error           String?
  attemptCount    Int                   @default(0)
  startedAt       DateTime?
  completedAt     DateTime?

  extractionRun ExtractionRun         @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)
  candidates    ExtractionCandidate[]

  @@unique([extractionRunId, stage])
  @@map("extraction_stages")
}

// The single generalized candidate table (task's own explicit permission for
// "a simpler normalized equivalent" over 8 separate Candidate* tables),
// `kind`-discriminated with a JSON payload - the same shape this codebase
// already uses for EligibilityCondition.kind/RuleActivationCondition.predicateConfig.
// Each stage's own candidate kind(s):
//   STRUCTURE        -> DOCUMENT_RELATIONSHIP (proposed Document.type +
//                        supersedesDocumentId + article/section outline -
//                        exactly what Document.typeConfirmedByUser /
//                        amendmentRelationshipConfirmedByUser above gate)
//   DEFINITIONS      -> DEFINED_TERM
//   PERMISSIONS      -> PERMISSION, COLLATERAL_SCOPE
//   RELATIONSHIPS    -> RELATIONSHIP, SHARED_CONSTRAINT, ACTIVATION_CONDITION
//   COVERAGE         -> PERMISSION (a KNOWN_NOT_MODELED-style placeholder for
//                        a real provision this run found no other stage
//                        modeled - reviewStatus REVIEW_REQUIRED, never
//                        auto-approved)
//   FINANCIAL_INPUTS -> EXTERNAL_INPUT_REQUIREMENT
model ExtractionCandidate {
  id                String                  @id @default(cuid())
  extractionRunId   String
  extractionStageId String
  companyId         String
  kind              ExtractionCandidateKind

  sourceDocumentId String
  sourceChunkIds   String[]
  sourcePage       Int?
  sourceSectionRef String?
  // A short quoted snippet for display without re-fetching the chunk row.
  sourceExcerpt    String?

  // Kind-specific structured payload (lib/extraction/schemas.ts has the zod
  // shape validated against before a row is ever written here).
  proposedValue Json
  confidence    Float?
  // Short, structured justification ONLY - never a raw chain-of-thought
  // trace (task's hard constraint; lib/extraction/provider.ts discards any
  // extended-reasoning content before this field is populated).
  rationale     String?

  reviewStatus        ExtractionCandidateReviewStatus @default(PENDING)
  // The reviewer's corrected version. `proposedValue` above is NEVER
  // overwritten - it stays the permanent record of what the AI originally
  // proposed, independent of what a reviewer later changed it to.
  reviewerEditedValue Json?
  reviewedAt          DateTime?
  // Never fabricated - left null unless a real identity is genuinely
  // available (matches this project's established "never invent a reviewer
  // name" discipline - see LegalReviewRecord.reviewerName above).
  reviewedBy          String?

  // Set once Phase 2's promotion step creates the real Permission/etc. row
  // this candidate became. Both columns are unused by anything in this
  // migration or in lib/extraction/** - they exist here only so Phase 2 has
  // somewhere to write the outcome.
  promotedAt   DateTime?
  promotedToId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  extractionRun   ExtractionRun          @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)
  extractionStage ExtractionStage        @relation(fields: [extractionStageId], references: [id], onDelete: Cascade)
  company         Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceDocument  Document               @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  reviewEvents    CandidateReviewEvent[]

  @@index([companyId])
  @@index([extractionRunId])
  @@index([extractionStageId])
  @@index([sourceDocumentId])
  @@index([kind, reviewStatus])
  @@map("extraction_candidates")
}

enum ExtractionCandidateKind {
  DEFINED_TERM
  PERMISSION
  RELATIONSHIP
  SHARED_CONSTRAINT
  COLLATERAL_SCOPE
  ACTIVATION_CONDITION
  DOCUMENT_RELATIONSHIP
  EXTERNAL_INPUT_REQUIREMENT
  // Additive (docs/autonomous-retrieval-phase-a-foundation.md), same pattern
  // as every prior enum extension in this codebase (ALTER TYPE ... ADD VALUE
  // is additive only, no existing row affected). A financial fact discovered
  // or uploaded through a source connector (lib/connectors/**) becomes an
  // ExtractionCandidate row of this kind, going through the EXACT SAME
  // reviewStatus lifecycle / CandidateReviewEvent audit trail / reviewCandidate()
  // function every other candidate kind already uses - see FinancialFactValueSchema
  // in lib/extraction/schemas.ts. No parallel review/audit system was built.
  FINANCIAL_FACT

  @@map("extraction_candidate_kind")
}

// PENDING - not yet reviewed. APPROVED - reviewer accepted proposedValue
// as-is. EDITED - reviewer accepted with changes (reviewerEditedValue set).
// REJECTED - reviewer determined this proposal should not be promoted.
// REVIEW_REQUIRED - the extraction pipeline itself flagged this as needing
// human attention before it can even be considered for approval (e.g. a
// COVERAGE-stage gap placeholder, or low-confidence output the provider
// itself was unsure of) - distinct from PENDING in that PENDING is simply
// "not yet looked at" while REVIEW_REQUIRED is "looked at by the pipeline
// and flagged as uncertain."
enum ExtractionCandidateReviewStatus {
  PENDING
  APPROVED
  EDITED
  REJECTED
  REVIEW_REQUIRED

  @@map("extraction_candidate_review_status")
}

// =============================================================================
// Company onboarding - Phase 2 (docs/company-onboarding-v1-implementation.md)
//
// Builds everything from "candidates exist in the DB" through "the company is
// live in the generalized product UI": review workspace, transactional
// promotion, post-promotion coverage-gate evaluation, financial onboarding,
// facility mapping, compliance-certificate proposal flow, golden-test
// proposal generation, and the onboarding wizard UI. Additive only - zero new
// columns on any table Phase 1 or earlier already shipped, except this one
// new table below (an audit trail, per the task's own "legitimate reason to
// add a small additive table" allowance).
// =============================================================================

// One row per review DECISION ever made on an ExtractionCandidate - the full
// history the brief requires beyond what reviewedAt/reviewedBy alone give
// (those two columns only ever hold the LATEST decision). Never mutated or
// deleted once written; a later decision on the same candidate is always a
// NEW row, so a reviewer's prior decision is never silently overwritten
// without a trace. `previousStatus`/`newStatus` bracket exactly what changed;
// `editedValue` is populated only for an EDIT action (a snapshot of what
// reviewerEditedValue was set to at that moment - ExtractionCandidate's own
// reviewerEditedValue column always reflects the LATEST edit, this table
// preserves every one that came before it too).
model CandidateReviewEvent {
  id             String                          @id @default(cuid())
  candidateId    String
  action         CandidateReviewAction
  previousStatus ExtractionCandidateReviewStatus
  newStatus      ExtractionCandidateReviewStatus
  editedValue    Json?
  note           String?
  // Never fabricated - see ExtractionCandidate.reviewedBy's own comment. In
  // this app (no auth system - see lib/auth.ts's absence, confirmed before
  // writing this table), populated from a plain text field the human
  // reviewer using the review workspace types their own name/email into,
  // never invented on their behalf.
  reviewedBy     String?

  createdAt DateTime @default(now())

  candidate ExtractionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_review_events")
}

enum CandidateReviewAction {
  APPROVE
  EDIT
  REJECT
  REVIEW_REQUIRED

  @@map("candidate_review_action")
}

// =============================================================================
// Autonomous information retrieval - Phase A foundation
// (docs/autonomous-retrieval-phase-a-foundation.md)
//
// Builds the connector/registry/ingestion foundation that lets a company
// connect data sources (SEC EDGAR for documents, CSV/Excel upload for
// financial figures) and have Headroom autonomously discover/fetch/classify/
// dedupe/extract what it needs - converging with the EXISTING manual-upload
// path (Phase 1/2 above) into one unified pipeline, rather than a parallel
// architecture. Phase B (a later pass) builds reconciliation, the canonical
// company-state aggregation service, and the review-queue UI on top of this.
//
// Additive only. Zero rows for Coherent/Matthews as of this migration - see
// Company's own comment above. Nothing in lib/covenant-engine.ts,
// lib/solver/**, or lib/onboarding/promotion.ts reads any table below; only
// lib/connectors/** does. A connector NEVER writes directly to Permission/
// PermissionRelationship/FinancialState/FinancialSnapshot/etc - every fact it
// discovers lands as a reviewable ExtractionCandidate first, exactly like
// Phase 1/2's own contractual-candidate flow (lib/onboarding/promotion.ts
// remains the only writer of real rows from a candidate).
// =============================================================================

enum ConnectorType {
  EDGAR
  CSV_FINANCIAL
  DOCUMENT_UPLOAD

  @@map("connector_type")
}

enum ConnectionStatus {
  CONNECTED
  ERROR
  DISCONNECTED

  @@map("connection_status")
}

// One company's connection to one data source. `capabilities` deliberately
// stores the ConnectorCapability conceptual enum (lib/connectors/types.ts) as
// a plain String[], not a Prisma enum array - capability sets are per-
// connector-INSTANCE (e.g. one CSV upload might carry only cash figures,
// another might carry debt balances too), so a closed Postgres enum column
// would force a schema change every time a new capability combination shows
// up. `credentialRef` is an OPAQUE reference only (e.g. an env-var name) -
// this column, like every column on this table, must NEVER hold a raw
// credential value; EDGAR needs no credential at all (public API), so it is
// null for every EDGAR connection created by this phase.
//
// Every company has exactly one DOCUMENT_UPLOAD-type row, auto-created (see
// getOrCreateUploadConnection in lib/connectors/registry.ts) - this is how
// manual upload "converges into the same ingestion system" per the brief: a
// first-class source connection like any other, not a special case. The
// @@unique([companyId, connectorType]) constraint below is what makes
// "exactly one" a database-enforced guarantee, not just a convention - and
// generalizes the same way to EDGAR/CSV_FINANCIAL (one connection per
// connector type per company for this V1; a company that wants a second
// EDGAR connection, e.g. for a second ticker, is out of scope here).
model CompanySourceConnection {
  id                   String           @id @default(cuid())
  companyId            String
  connectorType        ConnectorType
  provider             String
  status               ConnectionStatus @default(CONNECTED)
  capabilities         String[]
  sourcePriority       Int              @default(0)
  lastSuccessfulSyncAt DateTime?
  cursor               String?
  errorState           String?
  enabled              Boolean          @default(true)
  // Opaque reference only (e.g. an env-var name) - NEVER a raw credential
  // value. See this model's own header comment.
  credentialRef        String?
  // Connector-specific NON-SECRET config, e.g. EDGAR's { ticker, cik }.
  config               Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceArtifacts SourceArtifact[]
  ingestionJobs   IngestionJob[]

  @@unique([companyId, connectorType])
  @@index([companyId])
  @@map("company_source_connections")
}

enum SourceArtifactType {
  DOCUMENT
  FINANCIAL_RECORD

  @@map("source_artifact_type")
}

// The dedup ledger: one row per genuinely-distinct piece of content this
// company has ever ingested from ANY source connector, keyed by
// (companyId, contentHash) - a sha256 of the raw bytes (DOCUMENT) or of a
// canonicalized JSON encoding of the row (FINANCIAL_RECORD). This unique
// constraint IS the dedup mechanism (lib/connectors/dedup.ts): a second
// artifact with the same hash for the same company is never a new row - see
// that file's own comment for the "arrived via 2 sources" provenance choice
// (recorded in provenanceMetadata.duplicateSources, not a second row or a
// separate join table - the smallest correct representation for this phase).
//
// `documentId` is set once a DOCUMENT artifact has been materialized into a
// real Document row (the CLASSIFY_DEDUPE ingestion stage) - null until then,
// and always null for a FINANCIAL_RECORD artifact (those become
// ExtractionCandidate rows directly in the EXTRACT stage, never a Document).
model SourceArtifact {
  id                 String             @id @default(cuid())
  companyId          String
  sourceConnectionId String
  artifactType       SourceArtifactType
  sourceIdentifier   String?
  sourceUri          String?
  retrievedAt        DateTime
  effectiveDate      DateTime?
  contentHash        String
  mimeType           String?
  // DOCUMENT artifacts: an opaque DocumentStorageProvider ref, reusing
  // lib/document-storage/** exactly like Phase 1's upload path - never a
  // second storage mechanism.
  storageRef         String?
  // FINANCIAL_RECORD artifacts: the raw source row/object, JSON-safe.
  rawPayload         Json?
  provenanceMetadata Json?
  documentId         String?

  createdAt DateTime @default(now())

  company          Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceConnection CompanySourceConnection @relation(fields: [sourceConnectionId], references: [id], onDelete: Cascade)
  document         Document?               @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([companyId, contentHash])
  @@index([companyId])
  @@index([sourceConnectionId])
  @@index([documentId])
  @@map("source_artifacts")
}

enum IngestionJobKind {
  INITIALIZE
  SYNC
  AMENDMENT_PROCESS

  @@map("ingestion_job_kind")
}

// Mirrors ExtractionRun/ExtractionStage's exact proven discipline
// (lib/extraction/run-stage.ts) - a durable, Postgres-persisted job/stage
// pair rather than an in-memory queue, so this is Vercel-compatible by
// construction (one HTTP request processes one stage, or drives every
// pending stage in a loop like runAllPendingStages - see
// lib/connectors/ingestion.ts's runAllPendingIngestionStages - stopping at
// the first failure; never one giant synchronous "discover, fetch, extract
// everything" request).
//
// `sourceConnectionId` is nullable because a job can span connectors (e.g. an
// INITIALIZE job that discovers/fetches from every enabled connection a
// company has, not just one).
model IngestionJob {
  id                 String           @id @default(cuid())
  companyId          String
  sourceConnectionId String?
  kind               IngestionJobKind

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceConnection CompanySourceConnection? @relation(fields: [sourceConnectionId], references: [id], onDelete: SetNull)
  stages           IngestionJobStage[]

  @@index([companyId])
  @@index([sourceConnectionId])
  @@map("ingestion_jobs")
}

enum IngestionStageKind {
  DISCOVER
  FETCH
  CLASSIFY_DEDUPE
  EXTRACT
  RECONCILE
  COMPLETE

  @@map("ingestion_stage_kind")
}

// A dedicated enum, deliberately NOT a reuse of the literal
// ExtractionStageStatus Postgres type (which lib/extraction/** already owns)
// - same four-value SHAPE (task instruction: "reusing the pattern of
// ExtractionStageStatus"), but a genuinely independent type, so an ingestion-
// specific status value could be added later without touching the
// extraction pipeline's own enum or any migration that references it.
enum IngestionStageStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
  FAILED

  @@map("ingestion_stage_status")
}

// One (ingestionJobId, stage) row - the exact same retry/resume unit
// ExtractionStage established: @@unique([ingestionJobId, stage]) below is
// what makes a retry an UPDATE, never a duplicate INSERT, and what lets a
// FAILED stage's retry leave every sibling stage's COMPLETE row untouched.
// See lib/connectors/ingestion.ts's runIngestionJobStage for the full
// contract (assembles each stage's input from PERSISTED prior-stage state
// only - never in-memory - one prisma.$transaction per stage's writes).
//
// `output` is this stage's own durable, stage-scoped result payload (e.g.
// DISCOVER's list of DiscoveredSourceItem, FETCH's list of created
// SourceArtifact ids) - a deliberate "persist minimally and durably" choice
// over a whole new join table per stage-output shape (documented in
// lib/connectors/ingestion.ts), consistent with ExtractionCandidate's own
// "JSON payload, not 8 separate tables" precedent in this codebase.
model IngestionJobStage {
  id                String               @id @default(cuid())
  ingestionJobId    String
  stage             IngestionStageKind
  status            IngestionStageStatus @default(PENDING)
  error             String?
  attemptCount      Int                  @default(0)
  recordsDiscovered Int                  @default(0)
  recordsChanged    Int                  @default(0)
  output            Json?
  startedAt         DateTime?
  completedAt       DateTime?

  ingestionJob IngestionJob @relation(fields: [ingestionJobId], references: [id], onDelete: Cascade)

  @@unique([ingestionJobId, stage])
  @@map("ingestion_job_stages")
}

// Phase B reads this to decide, per metric, which connector's figure wins
// when sources disagree (e.g. a compliance-certificate-derived EBITDA
// outranks a CSV-derived one) - reconciliation LOGIC itself is explicitly
// Phase B's job (see this file's own header comment), this phase only builds
// the table + a few sensible seeded defaults. `companyId: null` means a
// global default rule; `priority`: LOWER NUMBER = HIGHER PRIORITY (a rule
// with priority 0 wins over priority 10), the same convention
// Company.onboardingStatus-adjacent SourcePriority-style fields in this
// codebase already use for sourcePriority on CompanySourceConnection above.
model SourcePriorityRule {
  id            String        @id @default(cuid())
  companyId     String?
  metricName    String
  connectorType ConnectorType
  priority      Int

  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, metricName])
  @@map("source_priority_rules")
}

// =============================================================================
// Phase B - Comprehensive Contract Model Foundation
// (docs/contract-model-foundation-phase-b.md, docs/comprehensive-contract-compiler-v1.md)
//
// EXTENSION, NOT REWRITE (task §3): every model below is additive. Nothing
// above this line is altered, dropped, or repurposed. Coherent/Matthews'
// existing Permission/PermissionRelationship/CovenantProvision rows and the
// legacy + solver-native engines that read them are completely untouched -
// zero rows are backfilled into any table below for either company. See
// docs/contract-model-foundation-phase-b.md §U for the read-time
// compatibility mapping (lib/contract-model/compatibility.ts) that projects
// existing Permission rows into this shape ON DEMAND, rather than a data
// migration duplicating them.
//
// Stable keys (task §10/§48/§49): every model below carries a `stableKey`
// String column, always caller-supplied (never server-generated, never
// derived from the row's own `id`), unique per company
// (`@@unique([companyId, stableKey])`). This mirrors this schema's own
// pre-existing `Permission.code`/`CovenantProvision.code` convention exactly
// (an optional human-chosen stable string, unrelated to the generated primary
// key) - see lib/contract-model/stable-keys.ts for the deterministic
// content-hash helper future extraction can use to construct one.
// =============================================================================

