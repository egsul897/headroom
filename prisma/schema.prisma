  JUDGMENT_REQUIRED
  UNSUPPORTED

  @@map("rule_evaluation_class")
}

// A rule's basic posture - orthogonal to ContractRuleType (a RATIO_TEST can
// be the PERMISSION gate for an action or a standalone OBLIGATION to satisfy
// no matter what). N_A covers rule types that are neither (DEFINITION,
// CALCULATION_RULE).
enum ContractRulePosture {
