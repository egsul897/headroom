enum DocumentRelationshipType {
  AMENDS
  RESTATES
  SUPPLEMENTS
  SUPERSEDES
  INCORPORATES_BY_REFERENCE
  GOVERNS
  SECURES
  GUARANTEES
  SUBORDINATES
  INTERCREDITOR_WITH
  MODIFIES_COLLATERAL
  MODIFIES_GUARANTOR_STRUCTURE
  REPLACES_SECTION
  ADDS_SECTION
  DELETES_SECTION
  // Phase 2C (task §6) - additive, same ALTER TYPE ADD VALUE safety as
  // every other enum extension in this file. AMENDS_AND_RESTATES/
  // INTERCREDITOR_RELATIONSHIP/REFERENCES/RELATED_TO/SUPERSEDES_CANDIDATE
  // from the task's own §6 list are deliberately NOT added here - they
  // reuse the closest existing real value instead (RESTATES,
  // INTERCREDITOR_WITH, INCORPORATES_BY_REFERENCE, and SUPERSEDES with
  // resolved=false/reviewStatus=REVIEW_REQUIRED standing in for the
  // "_CANDIDATE" distinction, which the resolution-status fields already
  // express) - only JOINS and CERTIFIES_COMPLIANCE_WITH have no adequate
  // existing member to reuse.
  JOINS
  CERTIFIES_COMPLIANCE_WITH

  @@map("document_relationship_type")
}

enum AmendmentEffectType {
  REPLACE_TEXT
  ADD_TEXT
  DELETE_TEXT
  MODIFY_THRESHOLD
  MODIFY_DEFINITION
  MODIFY_RELATIONSHIP
  MODIFY_ENTITY_SCOPE
  MODIFY_EFFECTIVE_DATE
  ADD_EXCEPTION
  REMOVE_EXCEPTION
  ADD_COVENANT
  REMOVE_COVENANT
  // Phase 2C (task §9) - additive, same ALTER TYPE ADD VALUE safety as
  // every other enum extension in this file. Pre-legal-construction
  // MODIFICATION CANDIDATES (an amendment statement has been detected and
  // its target identified, but which of the fine-grained effect types
  // above actually applies has not yet been classified) need a coarser,
  // honest "modifies something, kind not yet determined" value rather than
  // forcing a specific fine-grained guess; UNKNOWN_CHANGE covers a detected
  // amendment statement whose operation itself (add/delete/modify) could
  // not be determined from the text either.
  MODIFY_PROVISION
  UNKNOWN_CHANGE
  // Phase 2G (docs/phase-2g-amendment-precedence.md §5) - additive, same
  // ALTER TYPE ADD VALUE safety as every other enum extension in this
  // file. MODIFY_DEFINITION above was, until this phase, the only
  // definition-change value - too coarse once real amendment parsing
  // (not just candidate detection) needs to distinguish a definition
  // being added outright from one being deleted outright from one being
  // replaced outright; MODIFY_DEFINITION itself is kept as the honest
  // fallback for a detected definition change whose exact shape isn't
  // determinable. RESTATE_AGREEMENT represents a full amendment-and-
  // restatement (task §14 - "do not apply hundreds of artificial
  // section-by-section amendments if source/legal structure establishes
  // a full restatement relationship"), distinct from REPLACE_TEXT's own
  // section-level scope. REAFFIRM covers an amendment/joinder that
  // reaffirms an existing obligation (e.g. a guarantee) without altering
  // its text (task §16/§25 scenario 20). NO_TEXTUAL_CHANGE covers a
  // detected amendment-shaped statement that, on inspection, changes
  // nothing operative (e.g. a pure administrative/notice provision).
  ADD_DEFINITION
  DELETE_DEFINITION
  REPLACE_DEFINITION
  RESTATE_AGREEMENT
  REAFFIRM
  NO_TEXTUAL_CHANGE
  // Phase 2G, added after real CONMED Document D evidence (its own
  // Section 1(b): "the 'Term A-2 Commitments' set forth on Schedule 1 of
  // this Amendment are hereby added to Schedule 1.1 of the Credit
  // Agreement") showed a genuine schedule-modification clause that none
  // of the values above honestly describes - same additive ALTER TYPE ADD
  // VALUE safety as every extension above.
  MODIFY_SCHEDULE

  @@map("amendment_effect_type")
}

